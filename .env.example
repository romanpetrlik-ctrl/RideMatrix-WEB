PORT=5080
APP_TITLE=RideMatrix
API_BASE_URL=http://127.0.0.1:4000
# PostgreSQL database URL used for customer persistence and auth
DATABASE_URL=******127.0.0.1:5432/ridematrix
# Set to "false" in production to skip inserting the 18 demo/seed customers on
# a fresh database. Defaults to disabled automatically when NODE_ENV=production.
SEED_DEMO_DATA=false
# Must be explicitly set to "true" (in addition to running with --confirm) to
# allow the demo customer cleanup script (npm run cleanup:demo) to delete data.
ALLOW_DEMO_CLEANUP=false

# HMAC signing key for CSRF tokens (see docs/csrf-protection.md). Set to a long
# random value in production so tokens stay valid across restarts/instances.
CSRF_SECRET=

# Google Maps Platform integration. Keep disabled until the APIs and restrictions
# documented in docs/maps.md are configured.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=
