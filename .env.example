PORT=5080
APP_TITLE=RideMatrix
API_BASE_URL=http://127.0.0.1:4000
# SQLite database file used for customer persistence (relative paths resolve from the project root)
DATABASE_FILE=data/ridematrix.sqlite
# Set to "false" in production to skip inserting the 18 demo/seed customers on
# a fresh database. Defaults to disabled automatically when NODE_ENV=production.
SEED_DEMO_DATA=true
# Must be explicitly set to "true" (in addition to running with --confirm) to
# allow the demo customer cleanup script (npm run cleanup:demo) to delete data.
ALLOW_DEMO_CLEANUP=false
