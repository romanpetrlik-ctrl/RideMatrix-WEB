PORT=5080
APP_TITLE=RideMatrix
API_BASE_URL=http://127.0.0.1:4000
# Leave blank unless the reverse proxy's source IP/CIDR as seen by this app
# has been verified. Multiple addresses/ranges may be comma-separated.
TRUSTED_PROXY_IPS=
# PostgreSQL database URL used for customer persistence and auth
DATABASE_URL=******127.0.0.1:5432/ridematrix
# Set to "false" in production to skip inserting the 18 demo/seed customers on
# a fresh database. Defaults to disabled automatically when NODE_ENV=production.
SEED_DEMO_DATA=false
# Must be explicitly set to "true" (in addition to running with --confirm) to
# allow the demo customer cleanup script (npm run cleanup:demo) to delete data.
ALLOW_DEMO_CLEANUP=false

# HMAC signing key for CSRF tokens (see docs/csrf-protection.md). Set to a long
# random value in production so tokens stay valid across restarts/instances.
CSRF_SECRET=

# Initial setup bootstrap allow-list (comma separated normalized emails).
# Leave empty only in development; in production set this before first bootstrap.
INITIAL_SETUP_ALLOWED_EMAILS=

# Test-account notifications must stay in internal sinks only.
# Allowed values: "mailpit" or "internal". Any other value fails closed for
# setup-registered test accounts requesting access codes.
TEST_NOTIFICATION_SINK_MODE=mailpit

# Customer lifecycle defaults. Confirm production values for the applicable
# jurisdiction and licensing/retention requirements before importing data.
CUSTOMER_INACTIVITY_MONTHS=12
CUSTOMER_RETENTION_MONTHS=24
CUSTOMER_PURGE_MODE=anonymize

# Google Maps Platform integration. Keep disabled until the APIs and restrictions
# documented in docs/maps.md are configured.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_DEFAULT_LATITUDE=
GOOGLE_MAPS_DEFAULT_LONGITUDE=

# Stripe Checkout and payment webhook.
APP_BASE_URL=https://example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Amazon SES SMTP (Mailpit can be used in development).
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_FROM_EMAIL=

# WhatsApp Cloud API and approved template names.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=vXX.X
WHATSAPP_TEMPLATE_LANGUAGE=en_GB
WHATSAPP_PAYMENT_LINK_TEMPLATE=
WHATSAPP_PAYMENT_CANCELLED_TEMPLATE=
WHATSAPP_BOOKING_REMINDER_TEMPLATE=
WHATSAPP_DRIVER_REMINDER_TEMPLATE=
WHATSAPP_LIVE_STATUS_TEMPLATE=

# Microsoft 365 dispatch calendar and driver OAuth.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_CALENDAR_USER=
M365_CALENDAR_ID=
M365_DRIVER_CLIENT_ID=
M365_DRIVER_CLIENT_SECRET=

# Google driver calendar OAuth.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# AES-256 key for encrypted driver calendar OAuth tokens (32 random bytes, base64).
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Document vault storage and upload controls.
DOCUMENT_VAULT_ROOT=/opt/ridematrix/DocuVault
DOCUMENT_MAX_FILE_SIZE_MB=10
DOCUMENT_MAX_FILES_PER_CATEGORY=5
DOCUMENT_ALLOWED_MIME=application/pdf,image/jpeg,image/png
