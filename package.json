{
  "name": "ridematrix-web",
  "version": "0.1.0",
  "private": true,
  "description": "RideMatrix public web layer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc --noEmit -p tsconfig.test.json && tsx src/test-run.ts --unit",
    "test:integration": "tsc --noEmit -p tsconfig.test.json && tsx src/test-run.ts --integration",
    "test:all": "tsc --noEmit -p tsconfig.test.json && tsx src/test-run.ts --all",
    "db:migrate": "tsx src/jobs/db-migrate.ts",
    "audit:db": "tsx src/jobs/db-audit.ts",
    "cleanup:inactive": "tsx src/jobs/nightly-cleanup.ts",
    "cleanup:demo": "tsx src/jobs/demo-cleanup.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
