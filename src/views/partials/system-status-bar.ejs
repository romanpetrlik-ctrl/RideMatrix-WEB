<%
  const systemStatusText = typeof systemStatus === "string" && systemStatus.trim()
    ? systemStatus.trim()
    : "System status: Healthy";

  const userHref = typeof currentUserHref === "string" && currentUserHref.trim()
    ? currentUserHref.trim()
    : "/account";

  const statusBarAccount = typeof systemStatusBar === "object" && systemStatusBar
    ? systemStatusBar
    : {
        authenticated: typeof currentUserEmail === "string" && currentUserEmail.trim(),
        currentUserEmail,
        availableWorkspaceModuleCount: 0,
        hideWorkspaceSwitch: false
      };
  const isAuthenticated = Boolean(statusBarAccount.authenticated);
  const currentUserLabel = typeof statusBarAccount.currentUserEmail === "string" && statusBarAccount.currentUserEmail.trim()
    ? statusBarAccount.currentUserEmail.trim()
    : "Guest";
  const showWorkspaceSwitch = isAuthenticated
    && statusBarAccount.availableWorkspaceModuleCount > 1
    && !statusBarAccount.hideWorkspaceSwitch;
%>

<div class="system-status-bar">
  <div class="system-status-bar__inner">
    <div class="system-status-bar__left">
      <div class="system-status-bar__brand" aria-label="RideMatrix">
        <span class="system-status-bar__brand-mark" aria-hidden="true"></span>
        <span><%= appTitle %></span>
      </div>

      <div class="system-status-bar__status" aria-label="System status">
        <span class="system-status-bar__status-dot" aria-hidden="true"></span>
        <span><%= systemStatusText %></span>
      </div>
    </div>

    <div class="system-status-bar__center">
      <span
        class="system-status-bar__clock"
        data-system-clock
        aria-label="Current local date and time"
      >
        Loading local time...
      </span>
    </div>

    <div class="system-status-bar__right">
      <% if (isAuthenticated) { %>
        <a class="system-status-bar__user-link" href="/recovery">Help / Recovery</a>
      <% } %>
      <a class="system-status-bar__user-link" href="<%= userHref %>">
        <%= currentUserLabel %>
      </a>
      <% if (isAuthenticated) { %>
        <div class="system-status-bar__account-actions" aria-label="Account actions">
          <% if (showWorkspaceSwitch) { %>
            <a class="system-status-bar__account-action system-status-bar__account-action--secondary" href="/choose-role">Switch workspace</a>
          <% } %>
          <form class="system-status-bar__account-action-form" method="post" action="/exit">
            <%- locals.csrfField || "" %>
            <button class="system-status-bar__account-action system-status-bar__account-action--danger" type="submit">Exit</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  (function () {
    const clockElement = document.querySelector("[data-system-clock]");
    if (!clockElement) return;

    function updateClock() {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat("en-GB", {
        weekday: "long",
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
      });

      clockElement.textContent = formatter.format(now).replace(",", " ·");
    }

    updateClock();
    setInterval(updateClock, 1000);
  })();
</script>
