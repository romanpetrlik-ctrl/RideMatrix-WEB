<div class="context-toolbar context-toolbar--customers">
  <form class="context-toolbar__form" method="get" action="/customers">
    <% if (status !== "all") { %>
      <input type="hidden" name="status" value="<%= status %>" />
    <% } %>

    <div class="context-toolbar__left">
      <nav class="context-tabs" aria-label="Customer status filters">
        <% statusTabs.forEach((tab) => { %>
          <a class="context-tab context-tab--dynamic<%= tab.isActive ? " context-tab--active" : "" %>" href="<%= tab.href %>"<%= tab.isActive ? ' aria-current="page"' : "" %>><%= tab.label %></a>
        <% }) %>
      </nav>

      <div class="context-toolbar__field">
        <label for="customers-search">Search</label>
        <input
          id="customers-search"
          type="search"
          name="q"
          value="<%= search %>"
          class="context-control--dynamic"
          placeholder="Surname, first name, email or phone"
        />
      </div>
    </div>

    <div class="context-toolbar__right">
      <div class="context-toolbar__field context-toolbar__field--compact">
        <label for="customers-per-page">Records per page</label>
        <select class="context-control--dynamic" id="customers-per-page" name="perPage" onchange="this.form.submit()">
          <% perPageOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= option === perPage ? "selected" : "" %>><%= option %></option>
          <% }) %>
        </select>
      </div>

      <a class="button button--dynamic-cta" href="/customers/register">New customer</a>
    </div>
  </form>
</div>
