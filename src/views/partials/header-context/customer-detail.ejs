<div class="context-toolbar context-toolbar--actions-only">
  <div class="context-toolbar__actions">
    <a class="button button--execute" href="<%= customer.newBookingHref %>">New Booking</a>

    <% if (customer.telHref) { %>
      <a class="button button--secondary" href="<%= customer.telHref %>">Call</a>
    <% } %>

    <% if (customer.whatsappHref) { %>
      <a class="button button--secondary" href="<%= customer.whatsappHref %>" target="_blank" rel="noopener noreferrer">Send WhatsApp message</a>
    <% } else { %>
      <span class="button button--secondary button--disabled" aria-disabled="true">WhatsApp unavailable</span>
    <% } %>

    <% if (customer.emailHref) { %>
      <a class="button button--secondary" href="<%= customer.emailHref %>">Send Email</a>
    <% } else { %>
      <span class="button button--secondary button--disabled" aria-disabled="true">Email unavailable</span>
    <% } %>

    <a class="button button--secondary" href="<%= customer.editHref %>">Edit Customer</a>

    <form class="inline-form" method="post" action="/customers/<%= customer.id %>/suspend?returnTo=<%= encodeURIComponent(backToCustomersHref) %>">
      <%- locals.csrfField || "" %>
      <button type="submit" class="button button--secondary">Suspend Customer</button>
    </form>

    <a class="button button--danger" href="<%= customer.deleteHref %>">Delete Record</a>
    <button class="button button--secondary" type="button" data-close-detail-window>Close window</button>
    <p class="customer-detail-close-fallback" data-close-detail-fallback role="status" hidden>
      This window can be closed after returning to the customer list in the original window.
    </p>
  </div>
</div>
<script src="/js/customer-window-coordination.js" defer></script>
