<%
  const headerContextBarPartial = typeof contextBarPartial === "string" && contextBarPartial.trim()
    ? contextBarPartial.trim()
    : "";
  const headerContextBarData = typeof contextBarData === "object" && contextBarData
    ? contextBarData
    : {};
  const headerContextActions = typeof contextBarActions !== "undefined" && Array.isArray(contextBarActions)
    ? contextBarActions
    : [];
%>

<header class="site-header">
  <% if (headerContextActions.length > 0) { %>
    <div class="container rm-page-shell site-header__inner">
      <div class="site-header__context-actions">
        <%- include("context-actions", { actions: headerContextActions }) %>
      </div>
      <div class="site-header__action-divider" aria-hidden="true"></div>
    </div>
  <% } %>

  <% if (headerContextBarPartial) { %>
    <div class="container rm-page-shell site-header__context">
      <% if (headerContextBarPartial) { %>
        <%- include(headerContextBarPartial, headerContextBarData) %>
      <% } %>
    </div>
  <% } %>
</header>
