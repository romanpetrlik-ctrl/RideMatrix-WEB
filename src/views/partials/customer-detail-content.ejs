<section class="customer-detail-layout">
  <div class="customer-detail-layout__information">
    <section class="panel customer-detail-panel">
      <div class="customer-detail-panel__header">
        <div>
          <h1><%= customer.surname %>, <%= customer.givenName %></h1>
          <p>Customer ID: <strong><%= customer.id %></strong></p>
        </div>
        <span class="status-pill status-pill--<%= customer.status.toLowerCase().replace(/\s+/g, "-") %>"><%= customer.status %></span>
      </div>

      <dl class="customer-detail-list">
        <div><dt>Title</dt><dd><%= customer.title || "—" %></dd></div>
        <div><dt>Email</dt><dd><%= customer.email || "No email on file" %></dd></div>
        <div>
          <dt>Phone</dt>
          <dd>
            <% if (customer.phoneDisplay && customer.phoneCountry) { %>
              <span class="phone-number-display" title="<%= customer.phoneCountry.countryName %> (<%= customer.phoneCountry.callingCode %>)" aria-label="<%= customer.phoneCountry.countryName %> (<%= customer.phoneCountry.callingCode %>)">
                <span aria-hidden="true"><%= customer.phoneFlag %></span>
                <%= customer.phoneDisplay %>
              </span>
              <span class="phone-number-actions">
                <% if (customer.telHref) { %><a class="button button--secondary" href="<%= customer.telHref %>">Call</a><% } %>
                <% if (customer.whatsappHref) { %><a class="button button--secondary" href="<%= customer.whatsappHref %>" target="_blank" rel="noopener noreferrer">Send WhatsApp message</a><% } %>
              </span>
            <% } else { %>No phone on file<% } %>
          </dd>
        </div>
        <div><dt>Created</dt><dd><%= customer.formattedCreatedAt %></dd></div>
        <div><dt>Last Login</dt><dd><%= customer.formattedLastLoginAt %></dd></div>
        <div><dt>Preferred Contact</dt><dd><%= customer.preferredContact %></dd></div>
        <div><dt>Company</dt><dd><%= customer.company || "—" %></dd></div>
        <div class="customer-detail-list__full">
          <dt>Home address</dt>
          <dd><%= customer.address || "No address on file" %></dd>
        </div>
        <div class="customer-detail-list__full">
          <dt>Notes</dt>
          <dd><%= customer.notes || "No internal notes recorded." %></dd>
        </div>
      </dl>
    </section>

    <section class="panel customer-bookings-panel">
      <div class="customer-bookings-panel__header">
        <div>
          <h2>Bookings</h2>
          <p><%= customer.bookings.length %> booking<%= customer.bookings.length === 1 ? "" : "s" %> linked to this customer.</p>
        </div>
        <a class="button button--secondary" href="<%= customer.bookingsHref %>" target="_blank" rel="noopener noreferrer">View all bookings</a>
      </div>
      <% if (customer.bookings.length > 0) { %>
        <div class="customers-table-wrapper">
          <table class="customers-table">
            <thead><tr><th scope="col">Reference</th><th scope="col">Service Date</th><th scope="col">Pickup</th><th scope="col">Dropoff</th><th scope="col">Status</th></tr></thead>
            <tbody>
              <% customer.bookings.forEach((booking) => { %>
                <tr><td><strong><%= booking.reference %></strong></td><td><%= booking.formattedServiceDate %></td><td><%= booking.pickup %></td><td><%= booking.dropoff %></td><td><span class="status-pill status-pill--booking"><%= booking.status %></span></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state empty-state--compact"><h3>No bookings yet</h3><p>Use the New Booking action in the dynamic bar to start a new booking for this customer.</p></div>
      <% } %>
    </section>
  </div>

  <aside class="panel customer-detail-layout__map" aria-labelledby="customer-home-map-title">
    <div class="customer-detail-layout__map-header">
      <h2 id="customer-home-map-title">Home address map</h2>
    </div>
    <%- include("./map-preview", {
      mapView,
      emptyTitle: "Home address map is unavailable for this customer.",
      emptyMessage: "A configured map and valid customer coordinates are required."
    }) %>
  </aside>
</section>
