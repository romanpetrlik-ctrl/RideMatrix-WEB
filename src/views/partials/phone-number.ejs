<%
  const componentPhoneId = typeof phoneId === "string" ? phoneId : "phone";
  const componentPhoneValue = typeof phoneValue === "string" ? phoneValue : "";
  const componentPhoneRequired = phoneRequired !== false;
%>
<div class="phone-number-component" data-phone-number>
  <label for="<%= componentPhoneId %>">Phone / WhatsApp<%= componentPhoneRequired ? " *" : "" %></label>
  <div class="phone-number-component__input">
    <span class="phone-number-component__flag" data-phone-flag aria-hidden="true">🌐</span>
    <input
      type="tel"
      id="<%= componentPhoneId %>"
      name="phone"
      value="<%= componentPhoneValue %>"
      autocomplete="tel"
      data-phone-input
      data-phone-default-country="GB"
      <%= componentPhoneRequired ? "required" : "" %>
      aria-describedby="<%= componentPhoneId %>-help"
    />
  </div>
  <span class="phone-number-component__country" data-phone-country id="<%= componentPhoneId %>-help">Enter a phone number</span>
  <span class="form-help phone-number-component__error" data-phone-error hidden>Phone number is not valid.</span>
  <div class="phone-number-component__actions" data-phone-actions hidden>
    <a class="button button--secondary button--small" data-phone-email href="" hidden>Send email</a>
    <a class="button button--secondary button--small" data-phone-tel href="">Call</a>
    <a class="button button--secondary button--small" data-phone-whatsapp href="" target="_blank" rel="noopener noreferrer">Send WhatsApp message</a>
  </div>
</div>
