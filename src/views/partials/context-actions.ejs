<% if (Array.isArray(actions) && actions.length > 0) { %>
  <nav class="context-bar__actions" aria-label="Page actions">
    <% actions.forEach((action) => {
      const tone = action.tone || (action.type === "submit" ? "execute" : "execute-helper");
      const semanticTone = tone === "primary" ? "execute" : tone === "secondary" ? "execute-helper" : tone === "danger" ? "execute-negative" : tone;
      const isNegative = tone === "danger" || tone === "execute-negative";
      const actionClass = `button button--admin-cta button--admin-cta--dynamic${isNegative ? " button--admin-cta--negative" : ` button--${semanticTone}`} site-header__action context-bar__action context-bar__action--${tone}`;
    %>
      <% if (action.type === "submit") { %>
        <button
          type="submit"
          class="<%= actionClass %>"
          <% if (action.formId) { %>form="<%= action.formId %>"<% } %>
        ><%= action.label %></button>
      <% } else { %>
        <a
          class="<%= actionClass %>"
          href="<%= action.href || '#' %>"
          <% if (action.target) { %>target="<%= action.target %>"<% } %>
          <% if (action.rel) { %>rel="<%= action.rel %>"<% } %>
        ><%= action.label %></a>
      <% } %>
    <% }); %>
  </nav>
<% } %>
