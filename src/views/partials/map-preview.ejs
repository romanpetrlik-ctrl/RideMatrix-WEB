<% if (mapView) { %>
  <div class="address-map-preview" data-map-latitude="<%= mapView.latitude %>" data-map-longitude="<%= mapView.longitude %>" data-map-zoom="<%= mapView.zoom %>" data-map-browser-key="<%= locals.mapBrowserApiKey || '' %>" data-map-id="<%= locals.mapId || '' %>" role="img" aria-label="Map showing <%= mapView.label %>">
    <div class="address-map-preview__canvas" aria-hidden="true"></div>
    <p><strong><%= mapView.label %></strong></p>
    <p><%= mapView.latitude.toFixed(5) %>, <%= mapView.longitude.toFixed(5) %></p>
    <p class="address-map-preview__error" data-map-error hidden>Map preview is temporarily unavailable.</p>
  </div>
  <% if (locals.includeScript !== false) { %>
    <script src="/js/google-map-preview.js" defer></script>
  <% } %>
<% } else { %>
  <div class="address-map-placeholder" role="status">
    <strong><%= emptyTitle %></strong>
    <p><%= emptyMessage %></p>
  </div>
<% } %>
