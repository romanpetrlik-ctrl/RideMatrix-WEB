<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../partials/system-status-bar", {
      appTitle,
      systemStatus: "System settings",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>
    <%- include("../partials/header", { appTitle }) %>
    <main class="container rm-page-shell booking-integrations-settings">
      <header class="new-booking-page__title">
        <h1>Booking integrations</h1>
        <p>Configure online booking lead time and check which integration credentials are available.</p>
        <a href="/settings">Back to System Settings</a>
      </header>
      <% if (notice === "saved") { %><section class="notice" role="status">Booking integration settings saved.</section><% } %>
      <% if (notice === "invalid") { %><section class="notice notice--critical" role="alert">Select a valid notice period.</section><% } %>
      <section class="panel rm-card">
        <h2>Online booking availability</h2>
        <p>This limit is for online-widget submissions only. Internal dispatcher bookings are not restricted by this setting.</p>
        <form method="post" action="/settings/booking-integrations">
          <%- locals.csrfField || "" %>
          <div class="form-field">
            <label for="minimumOnlineNoticeHours">Minimum notice before pickup</label>
            <select id="minimumOnlineNoticeHours" name="minimumOnlineNoticeHours" required>
              <% noticeHours.forEach((hours) => { %>
                <option value="<%= hours %>" <%= settings.minimumOnlineNoticeHours === hours ? "selected" : "" %>><%= hours %> hours</option>
              <% }) %>
            </select>
          </div>
          <button class="button" type="submit">Save settings</button>
        </form>
        <p class="form-hint">Current value: <%= settings.minimumOnlineNoticeHours %> hours. The online-widget API must enforce the same policy server-side.</p>
      </section>
      <section class="panel rm-card">
        <h2>Integration readiness</h2>
        <p>Secrets are read from the server environment and are never displayed here.</p>
        <ul class="booking-integrations-settings__readiness">
          <% integrations.forEach((integration) => { %>
            <li><strong><%= integration.name %>:</strong> <%= integration.status || (integration.ready ? "Configured" : "Not configured") %></li>
          <% }) %>
        </ul>
        <p><a href="/settings/payments/stripe">Configure Stripe payments</a></p>
        <p class="form-hint">Calendar OAuth, SES production access and approved WhatsApp templates must also be completed with their providers before production delivery.</p>
      </section>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
