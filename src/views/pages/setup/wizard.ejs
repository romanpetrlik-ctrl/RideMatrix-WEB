<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", {
      appTitle,
      systemStatus: "System status: Healthy",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>

    <%- include("../../partials/header", { appTitle }) %>

    <main class="container rm-page-shell setup-wizard">
      <section class="panel">
        <h1>Set up your RideMatrix account</h1>
        <p>We’ll guide you through a few short steps to configure your taxi or private-hire business.</p>
        <p>You will need your business details, operating addresses and PHO licence information. You can review everything before the setup is completed.</p>
        <% const stepTitles = {
          "/setup/bootstrap-superuser": "Confirm your administrator account",
          "/setup/operator-profile": "Business details",
          "/setup/registered-pho-address": "Registered business address",
          "/setup/operational-address": "Operating address",
          "/setup/pho-licence": "PHO licence details",
          "/setup/licence-document": "Upload your licence document",
          "/setup/review": "Review your information",
          "/setup/completed": "Finish setup"
        }; %>
        <p>Step <strong><%= Object.keys(stepTitles).indexOf(currentPath) + 1 %> of 8</strong>: <%= stepTitles[currentPath] || "Account setup" %></p>

        <% if (notice) { %>
          <section class="notice notice--success" role="status"><%= notice %></section>
        <% } %>

        <% if (errors.length > 0) { %>
          <section class="notice notice--critical" role="alert">
            <strong>Please correct the following issues:</strong>
            <ul>
              <% errors.forEach((errorMessage) => { %>
                <li><%= errorMessage %></li>
              <% }) %>
            </ul>
          </section>
        <% } %>

        <ol aria-label="Setup progress">
          <% Object.values(stepTitles).forEach((stepTitle) => { %>
            <li><%= stepTitle %></li>
          <% }) %>
        </ol>
      </section>

      <% if (requestedPath === stepPaths.bootstrap_superuser) { %>
        <section class="panel">
          <h2>Confirm your administrator account</h2>
          <p>In this step, enter the email address that will be used to create the system administrator account (superuser).</p>
          <p>This email address should not be shared with another user of the system. The superuser has, apart from limited technical exceptions, full rights across the entire system.</p>
          <p>The email address used to create the superuser is permanently recorded in the system. After the setup wizard has been completed, it cannot be changed through the normal application interface.</p>
          <p>This address is used for secure administrator sign-in. It is separate from the address used as the sender of production emails.</p>
          <form method="post" action="/setup/bootstrap-superuser">
            <%- locals.csrfField || "" %>
            <div class="setup-form__field">
              <label for="installerEmail">Administrator email address *</label>
              <input id="installerEmail" name="installerEmail" type="email" required value="<%= formData.installerEmail %>" />
            </div>
            <div class="setup-form__actions">
              <button type="submit">Confirm administrator account</button>
            </div>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.operator_profile) { %>
        <section class="panel">
          <h2>Business details</h2>
          <p>In this step, enter the details related to your business.</p>
          <p>Please use the official business and licence-holder names shown on your business or PHO documents.</p>
          <form method="post" action="/setup/operator-profile">
            <%- locals.csrfField || "" %>
            <div class="setup-form__field">
              <label for="legalName">Registered business name *</label>
              <input id="legalName" name="legalName" required value="<%= formData.legalName %>" />
            </div>
            <div class="setup-form__field">
              <label for="tradingName">Trading name</label>
              <input id="tradingName" name="tradingName" value="<%= formData.tradingName %>" />
            </div>
            <div class="setup-form__field">
              <label for="licenceHolderName">Name on the PHO licence *</label>
              <input id="licenceHolderName" name="licenceHolderName" required value="<%= formData.licenceHolderName %>" />
            </div>
            <div class="setup-form__actions">
              <button type="submit">Save business details and continue</button>
            </div>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.registered_pho_address || requestedPath === stepPaths.operational_address) { %>
        <% const addressType = requestedPath === stepPaths.registered_pho_address ? "registered_pho" : "operational"; %>
        <section class="panel">
          <h2><%= addressType === "registered_pho" ? "Where is your business registered?" : "Where do you operate from?" %></h2>
          <p><%= addressType === "registered_pho"
            ? "Enter the registered address associated with your business or PHO licence. This may be different from the address where your day-to-day operations take place."
            : "Enter the address used for your day-to-day taxi or private-hire operations. This may be your office, dispatch centre or operating base." %></p>
          <form method="post" action="<%= addressType === "registered_pho" ? "/setup/registered-pho-address" : "/setup/operational-address" %>">
            <%- locals.csrfField || "" %>
            <% [
              ["formattedAddress", "Formatted address *", formData.formattedAddress || "", true],
              ["houseNameNumber", "House name / number", formData.houseNameNumber || ""],
              ["addressLine1", "Address line 1 *", formData.addressLine1 || "", true],
              ["addressLine2", "Address line 2", formData.addressLine2 || ""],
              ["addressLine3", "Address line 3", formData.addressLine3 || ""],
              ["cityTown", "City / Town *", formData.cityTown || "", true],
              ["county", "County", formData.county || ""],
              ["state", "State", formData.state || ""],
              ["postcode", "Postcode *", formData.postcode || "", true],
              ["countryCode", "Country code *", formData.countryCode || "", true],
              ["countryName", "Country name *", formData.countryName || "", true],
              ["latitude", "Latitude", formData.latitude || ""],
              ["longitude", "Longitude", formData.longitude || ""],
              ["providerName", "Provider name", formData.providerName || ""],
              ["providerPlaceId", "Provider place id", formData.providerPlaceId || ""]
            ].forEach(([fieldName, fieldLabel, fieldValue, required]) => { %>
              <div class="setup-form__field">
                <label for="<%= fieldName %>"><%= fieldLabel %></label>
                <input id="<%= fieldName %>" name="<%= fieldName %>" <%= fieldName === "countryCode" ? 'maxlength="2"' : "" %> <%= required ? "required" : "" %> value="<%= fieldValue %>" />
              </div>
            <% }) %>
            <div class="setup-form__actions">
              <button type="submit"><%= addressType === "registered_pho" ? "Save registered address and continue" : "Save operating address and continue" %></button>
            </div>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.pho_licence) { %>
        <section class="panel">
          <h2>PHO licence details</h2>
          <p>Enter the licence information exactly as it appears on your PHO licence document.</p>
          <form method="post" action="/setup/pho-licence">
            <%- locals.csrfField || "" %>
            <div class="setup-form__field">
              <label for="licenceNumber">PHO licence number *</label>
              <input id="licenceNumber" name="licenceNumber" required value="<%= formData.licenceNumber %>" />
            </div>
            <div class="setup-form__field">
              <label for="licensingAuthorityId">Licensing authority *</label>
              <select id="licensingAuthorityId" name="licensingAuthorityId" required>
                <option value="">Select authority</option>
                <% authorities.forEach((authority) => { %>
                  <option value="<%= authority.id %>" <%= formData.licensingAuthorityId === authority.id ? "selected" : "" %>>
                    <%= authority.name %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="setup-form__field">
              <label for="validFrom">Licence valid from *</label>
              <input id="validFrom" name="validFrom" type="date" required value="<%= formData.validFrom %>" />
            </div>
            <div class="setup-form__field">
              <label for="validTo">Licence valid until</label>
              <input id="validTo" name="validTo" type="date" value="<%= formData.validTo %>" />
            </div>
            <p>If your licence does not have an expiry date, you may leave the final field empty.</p>
            <div class="setup-form__actions">
              <button type="submit">Save licence details and continue</button>
            </div>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.licence_document) { %>
        <section class="panel">
          <h2>Upload your PHO licence document</h2>
          <p>Upload a clear copy of your current PHO licence. The document will be stored securely with your business records and can be reviewed by authorised administrators.</p>
          <form method="post" action="/setup/licence-document" enctype="multipart/form-data">
            <%- locals.csrfField || "" %>
            <div class="setup-form__field">
              <label for="licenceDocument">Licence document *</label>
              <input id="licenceDocument" type="file" name="licenceDocument" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" required />
              <span>Accepted formats: PDF, PNG or JPEG. Maximum file size: 10 MB.</span>
            </div>
            <div class="setup-form__actions">
              <button type="submit">Upload document and continue</button>
            </div>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.review_confirmation) { %>
        <section class="panel">
          <h2>Review your setup details</h2>
          <p>Please check the information below before completing the installation.</p>
          <p>If anything needs correcting, you can return to an earlier step. The business will remain in TRIAL status until the relevant licence or subscription activation is completed.</p>
          <p>Business: <strong><%= setup.operator ? setup.operator.legalName : "Not configured" %></strong></p>
          <p>Registered address: <strong><%= setup.addresses.registeredPho ? "Complete" : "Missing" %></strong></p>
          <p>Operational address: <strong><%= setup.addresses.operational ? "Complete" : "Missing" %></strong></p>
          <p>PHO licence: <strong><%= setup.licence ? setup.licence.licenceNumber : "Missing" %></strong></p>
          <p>Licence document: <strong><%= setup.latestDocument ? setup.latestDocument.originalFilename : "Missing" %></strong></p>
          <form method="post" action="/setup/review">
            <%- locals.csrfField || "" %>
            <div class="setup-form__field setup-form__field--checkbox">
              <label>
                <input type="checkbox" name="confirmSetup" value="yes" />
                I have checked the information above and confirm that it is correct.
              </label>
            </div>
            <div class="setup-form__actions">
              <button type="submit">Complete RideMatrix setup</button>
            </div>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.completed) { %>
        <section class="panel">
          <h2>Your RideMatrix setup is complete</h2>
          <p>Your RideMatrix business setup has been completed.</p>
          <p>Your business is currently in TRIAL status for one month. After the relevant licence or subscription has been purchased and activated, the system can move the business to ACTIVE status automatically.</p>
          <p>You can now configure users, pricing, vehicles, bookings and notifications.</p>
          <p>Test accounts and test bookings are clearly marked and kept separate from real financial activity. Test email messages are delivered only to the internal test mailbox.</p>

        </section>
      <% } %>
    </main>

    <%- include("../../partials/footer") %>
  </body>
</html>
