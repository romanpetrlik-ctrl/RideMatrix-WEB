<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", {
      appTitle,
      systemStatus: "System status: Healthy",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>

    <%- include("../../partials/header", { appTitle }) %>

    <main class="container rm-page-shell">
      <section class="panel">
        <h1>Initial System Setup</h1>
        <% const stepTitles = {
          "/setup/bootstrap-superuser": "Step 1 — Bootstrap superuser",
          "/setup/operator-profile": "Step 2 — Operator profile",
          "/setup/registered-pho-address": "Step 3 — Registered PHO address",
          "/setup/operational-address": "Step 4 — Operational address",
          "/setup/pho-licence": "Step 5 — PHO licence",
          "/setup/licence-document": "Step 6 — Licence document upload",
          "/setup/review": "Step 7 — Review and confirmation",
          "/setup/completed": "Step 8 — Completion"
        }; %>
        <p>Current step: <strong><%= stepTitles[currentPath] || "Initial setup" %></strong></p>

        <% if (notice) { %>
          <section class="notice notice--success" role="status"><%= notice %></section>
        <% } %>

        <% if (errors.length > 0) { %>
          <section class="notice notice--critical" role="alert">
            <strong>Please correct the following issues:</strong>
            <ul>
              <% errors.forEach((errorMessage) => { %>
                <li><%= errorMessage %></li>
              <% }) %>
            </ul>
          </section>
        <% } %>

        <ol>
          <li>Bootstrap superuser</li>
          <li>Operator profile</li>
          <li>Registered PHO address</li>
          <li>Operational address</li>
          <li>PHO licence</li>
          <li>Licence document</li>
          <li>Review and confirm</li>
          <li>Completed</li>
        </ol>
      </section>

      <% if (requestedPath === stepPaths.bootstrap_superuser) { %>
        <section class="panel">
          <h2>Step 1 — Bootstrap verified superuser</h2>
          <p>Use the same email that is currently signed in via the existing login-code / magic-link flow.</p>
          <form method="post" action="/setup/bootstrap-superuser">
            <%- locals.csrfField || "" %>
            <label for="installerEmail">Installer email *</label>
            <input id="installerEmail" name="installerEmail" type="email" required value="<%= formData.installerEmail %>" />
            <button type="submit">Verify and assign superuser</button>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.operator_profile) { %>
        <section class="panel">
          <h2>Step 2 — Operator profile</h2>
          <form method="post" action="/setup/operator-profile">
            <%- locals.csrfField || "" %>
            <label for="legalName">Legal name *</label>
            <input id="legalName" name="legalName" required value="<%= formData.legalName %>" />
            <label for="tradingName">Trading name</label>
            <input id="tradingName" name="tradingName" value="<%= formData.tradingName %>" />
            <label for="licenceHolderName">Licence holder name *</label>
            <input id="licenceHolderName" name="licenceHolderName" required value="<%= formData.licenceHolderName %>" />
            <label for="operatorStatus">Lifecycle status *</label>
            <select id="operatorStatus" name="operatorStatus">
              <% ["setup_required", "active", "suspended", "archived"].forEach((statusOption) => { %>
                <option value="<%= statusOption %>" <%= formData.operatorStatus === statusOption ? "selected" : "" %>><%= statusOption %></option>
              <% }) %>
            </select>
            <button type="submit">Save and continue</button>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.registered_pho_address || requestedPath === stepPaths.operational_address) { %>
        <% const addressType = requestedPath === stepPaths.registered_pho_address ? "registered_pho" : "operational"; %>
        <section class="panel">
          <h2><%= addressType === "registered_pho" ? "Step 3 — Registered PHO address" : "Step 4 — Operational address" %></h2>
          <form method="post" action="<%= addressType === "registered_pho" ? "/setup/registered-pho-address" : "/setup/operational-address" %>">
            <%- locals.csrfField || "" %>
            <label for="formattedAddress">Formatted address *</label>
            <input id="formattedAddress" name="formattedAddress" required value="<%= formData.formattedAddress || '' %>" />
            <label for="houseNameNumber">House name / number</label>
            <input id="houseNameNumber" name="houseNameNumber" value="<%= formData.houseNameNumber || '' %>" />
            <label for="addressLine1">Address line 1 *</label>
            <input id="addressLine1" name="addressLine1" required value="<%= formData.addressLine1 || '' %>" />
            <label for="addressLine2">Address line 2</label>
            <input id="addressLine2" name="addressLine2" value="<%= formData.addressLine2 || '' %>" />
            <label for="addressLine3">Address line 3</label>
            <input id="addressLine3" name="addressLine3" value="<%= formData.addressLine3 || '' %>" />
            <label for="cityTown">City / Town *</label>
            <input id="cityTown" name="cityTown" required value="<%= formData.cityTown || '' %>" />
            <label for="county">County</label>
            <input id="county" name="county" value="<%= formData.county || '' %>" />
            <label for="state">State</label>
            <input id="state" name="state" value="<%= formData.state || '' %>" />
            <label for="postcode">Postcode *</label>
            <input id="postcode" name="postcode" required value="<%= formData.postcode || '' %>" />
            <label for="countryCode">Country code *</label>
            <input id="countryCode" name="countryCode" maxlength="2" required value="<%= formData.countryCode || '' %>" />
            <label for="countryName">Country name *</label>
            <input id="countryName" name="countryName" required value="<%= formData.countryName || '' %>" />
            <label for="latitude">Latitude</label>
            <input id="latitude" name="latitude" value="<%= formData.latitude || '' %>" />
            <label for="longitude">Longitude</label>
            <input id="longitude" name="longitude" value="<%= formData.longitude || '' %>" />
            <label for="providerName">Provider name</label>
            <input id="providerName" name="providerName" value="<%= formData.providerName || '' %>" />
            <label for="providerPlaceId">Provider place id</label>
            <input id="providerPlaceId" name="providerPlaceId" value="<%= formData.providerPlaceId || '' %>" />
            <button type="submit">Save and continue</button>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.pho_licence) { %>
        <section class="panel">
          <h2>Step 5 — PHO licence</h2>
          <form method="post" action="/setup/pho-licence">
            <%- locals.csrfField || "" %>
            <label for="licenceNumber">Licence number *</label>
            <input id="licenceNumber" name="licenceNumber" required value="<%= formData.licenceNumber %>" />
            <label for="licensingAuthorityId">Licensing authority *</label>
            <select id="licensingAuthorityId" name="licensingAuthorityId" required>
              <option value="">Select authority</option>
              <% authorities.forEach((authority) => { %>
                <option value="<%= authority.id %>" <%= formData.licensingAuthorityId === authority.id ? "selected" : "" %>>
                  <%= authority.name %>
                </option>
              <% }) %>
            </select>
            <label for="validFrom">Valid from *</label>
            <input id="validFrom" name="validFrom" type="date" required value="<%= formData.validFrom %>" />
            <label for="validTo">Valid to</label>
            <input id="validTo" name="validTo" type="date" value="<%= formData.validTo %>" />
            <button type="submit">Save and continue</button>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.licence_document) { %>
        <section class="panel">
          <h2>Step 6 — Licence document upload</h2>
          <form method="post" action="/setup/licence-document" enctype="multipart/form-data">
            <%- locals.csrfField || "" %>
            <label for="licenceDocument">Document (PDF, PNG, JPEG, max 10 MB) *</label>
            <input id="licenceDocument" type="file" name="licenceDocument" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" required />
            <button type="submit">Upload and continue</button>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.review_confirmation) { %>
        <section class="panel">
          <h2>Step 7 — Review and confirmation</h2>
          <p>Operator: <strong><%= setup.operator ? setup.operator.legalName : "Not configured" %></strong></p>
          <p>Registered address: <strong><%= setup.addresses.registeredPho ? "Complete" : "Missing" %></strong></p>
          <p>Operational address: <strong><%= setup.addresses.operational ? "Complete" : "Missing" %></strong></p>
          <p>PHO licence: <strong><%= setup.licence ? setup.licence.licenceNumber : "Missing" %></strong></p>
          <p>Document: <strong><%= setup.latestDocument ? setup.latestDocument.originalFilename : "Missing" %></strong></p>
          <form method="post" action="/setup/review">
            <%- locals.csrfField || "" %>
            <label>
              <input type="checkbox" name="confirmSetup" value="yes" />
              I confirm all setup details and want to complete initial setup.
            </label>
            <button type="submit">Complete setup</button>
          </form>
        </section>
      <% } %>

      <% if (requestedPath === stepPaths.completed) { %>
        <section class="panel">
          <h2>Step 8 — Completion</h2>
          <p>Initial setup is completed. Operator status is active and setup is locked.</p>
          <p>System test accounts are intentionally retained for production-safe testing and compliance demonstrations.</p>

          <h3>Superuser-only legacy cleanup path</h3>
          <form method="post" action="/setup/cleanup-accounts">
            <%- locals.csrfField || "" %>
            <% cleanupTargets.forEach((target) => { %>
              <label>
                <input type="checkbox" name="cleanupTargets" value="<%= target %>" />
                Deactivate internal operational roles for <%= target %>
              </label>
            <% }) %>
            <button type="submit">Run cleanup deactivation</button>
          </form>

          <h3>Test-account access-code routing check</h3>
          <form method="post" action="/setup/test-account-access-code">
            <%- locals.csrfField || "" %>
            <label for="testAccountEmail">Test account email</label>
            <input id="testAccountEmail" name="testAccountEmail" type="email" required />
            <button type="submit">Validate sink policy</button>
          </form>
        </section>
      <% } %>

      <section class="panel">
        <h2>Recent setup audit</h2>
        <% if (setupAudit.length === 0) { %>
          <p>No setup audit events recorded yet.</p>
        <% } else { %>
          <ul>
            <% setupAudit.forEach((auditEvent) => { %>
              <li>
                <strong><%= auditEvent.eventName %></strong>
                — <%= auditEvent.summary %>
                (<%= auditEvent.actorUserEmail || "system" %>, <%= auditEvent.occurredAt %>)
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </main>

    <%- include("../../partials/footer") %>
  </body>
</html>
