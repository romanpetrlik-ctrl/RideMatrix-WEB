<%- include("../layouts/base", {
  title,
  appTitle,
  currentUserEmail: email,
  currentUserHref: "/account",
  pageTitle: title,
  pageMeta: "System Settings · Fare Settings",
  activeRoleLabel: "System settings",
  hintsLabel: "Hints: Off",
  body: `
    <section class="panel fare-settings">
      <nav class="fare-settings__trail" aria-label="Navigation path">
        <ol>
          ${breadcrumbs.map((crumb) => `
            <li${crumb.href ? "" : ' aria-current="page"'}>${crumb.href ? `<a href="${crumb.href}">${crumb.label}</a>` : crumb.label}</li>
          `).join("")}
        </ol>
      </nav>
      <h1>${title}</h1>
      <p class="notice fare-settings__access" role="status"><strong>Access granted.</strong> Granted by your current session role(s): ${grantedByLabel}.</p>
      ${saved ? `<p class="notice fare-settings__saved" role="status">Fare settings saved.</p>` : ""}
      ${formError ? `<div class="notice fare-settings__error" role="alert">${formError}</div>` : ""}

      ${!category ? `
        <p class="fare-settings__intro">Configure fare-related settings. All settings are configuration only and are not used to calculate fares or change booking totals.</p>
        <nav class="fare-settings__categories" aria-label="Fare Settings categories">
          ${categories.map((item) => `
            <a class="fare-settings__category" href="/settings/fare-settings/${item.slug}">
              <span class="fare-settings__category-title">${item.title}</span>
              <span class="fare-settings__category-description">${item.description}</span>
              <span class="fare-settings__category-action">Open settings</span>
            </a>
          `).join("")}
        </nav>
      ` : !category.configurable ? `
        <p class="fare-settings__intro">${category.description}</p>
        <div class="notice fare-settings__placeholder" role="status">
          <strong>Configuration placeholder.</strong> This category is reserved for future configuration. No fare rules or pricing behavior are configured here.
        </div>
      ` : `
        <p class="fare-settings__intro">${category.description}</p>
        ${category.slug !== "distance-slabs" ? `<div class="notice fare-settings__configuration-only" role="status">
          This saves configuration only. No fare is calculated or applied and booking totals are unchanged. Time values use <strong>Europe/London</strong> local time.
        </div>` : ""}
        ${category.slug === "minimum-fare-rules" ? `
          <div class="notice fare-settings__configuration-only" role="status">
            This saves configuration only; no fare is calculated or applied and booking totals are unchanged. The intended future rule is <code>base fare = max(distance-slabs fare, configured minimum base fare)</code>. Airport fees are separate and are not included in the minimum.
          </div>
          <p class="fare-settings__help">Select a RideMatrix-managed location by its internal ID. The radius uses its configured operational point: drop-off coordinates for journeys to the airport and pick-up coordinates for journeys from it. The other endpoint must have usable coordinates within the inclusive straight-line/geodesic radius; road distance and postcode centroids are not used. Five miles is 8,046.72 metres.</p>
          <form class="fare-settings__form fare-settings__rule-card" method="post" action="/settings/fare-settings/${category.slug}" data-fare-rule-form>
            ${locals.csrfField || ""}
            <input type="hidden" name="baseVersion" value="${currentVersion}" />
            <input type="hidden" name="ruleId" value="" />
            <h2>Add minimum fare rule</h2>
            <div class="fare-settings__fields">
              <div class="fare-settings__field">
                <label for="minimum-rule-name">Rule name or description</label>
                <input id="minimum-rule-name" name="name" type="text" maxlength="160" required value="${ruleFormSubmitted && !ruleFormId ? ruleForm.name || "" : ""}" aria-invalid="${errors.name && !ruleFormId ? "true" : "false"}" aria-describedby="minimum-rule-name-error" />
                <p id="minimum-rule-name-error" class="fare-settings__field-error${errors.name && !ruleFormId ? " fare-settings__field-error--invalid" : ""}" ${errors.name && !ruleFormId ? 'role="alert"' : ""}>${!ruleFormId ? errors.name || "" : ""}</p>
              </div>
              <div class="fare-settings__field">
                <label for="minimum-rule-poi">Managed airport or point of interest</label>
                <select id="minimum-rule-poi" name="poiId" required aria-invalid="${errors.poiId && !ruleFormId ? "true" : "false"}" aria-describedby="minimum-rule-poi-help minimum-rule-poi-error">
                  <option value="">Select a managed location</option>
                  ${managedPois.map((poi) => `<option value="${poi.id}" ${ruleFormSubmitted && !ruleFormId && ruleForm.poiId === poi.id ? "selected" : ""}>${poi.displayName} — internal ID ${poi.id}</option>`).join("")}
                </select>
                <p id="minimum-rule-poi-help" class="fare-settings__help">The internal ID is the saved Airport Fees record, not a Google Places label.</p>
                <p id="minimum-rule-poi-error" class="fare-settings__field-error${errors.poiId && !ruleFormId ? " fare-settings__field-error--invalid" : ""}" ${errors.poiId && !ruleFormId ? 'role="alert"' : ""}>${!ruleFormId ? errors.poiId || "" : ""}</p>
              </div>
              <div class="fare-settings__field">
                <label for="minimum-rule-radius">Radius (miles)</label>
                <input id="minimum-rule-radius" name="radiusMiles" type="number" min="0.000001" step="any" inputmode="decimal" required value="${ruleFormSubmitted && !ruleFormId ? ruleForm.radiusMiles || "" : ""}" aria-invalid="${errors.radiusMiles && !ruleFormId ? "true" : "false"}" aria-describedby="minimum-rule-radius-error" />
                <p id="minimum-rule-radius-error" class="fare-settings__field-error${errors.radiusMiles && !ruleFormId ? " fare-settings__field-error--invalid" : ""}" ${errors.radiusMiles && !ruleFormId ? 'role="alert"' : ""}>${!ruleFormId ? errors.radiusMiles || "" : ""}</p>
              </div>
              <div class="fare-settings__field">
                <label for="minimum-rule-fare">Minimum base fare (GBP)</label>
                <div class="fare-settings__currency-input"><span aria-hidden="true">£</span><input id="minimum-rule-fare" name="minimumBaseFare" type="text" inputmode="decimal" pattern="(?:0|[1-9][0-9]{0,5})([.][0-9]{1,2})?" required value="${ruleFormSubmitted && !ruleFormId ? ruleForm.minimumBaseFare || "" : ""}" aria-invalid="${errors.minimumBaseFare && !ruleFormId ? "true" : "false"}" aria-describedby="minimum-rule-fare-error" /></div>
                <p id="minimum-rule-fare-error" class="fare-settings__field-error${errors.minimumBaseFare && !ruleFormId ? " fare-settings__field-error--invalid" : ""}" ${errors.minimumBaseFare && !ruleFormId ? 'role="alert"' : ""}>${!ruleFormId ? errors.minimumBaseFare || "" : ""}</p>
              </div>
            </div>
            <div class="fare-settings__actions"><button class="button button--primary" type="submit" name="ruleAction" value="save">Add minimum fare rule</button></div>
          </form>
          <section class="fare-settings__rule-list" aria-labelledby="minimum-rule-list-title">
            <h2 id="minimum-rule-list-title">Saved minimum fare rules</h2>
            ${configuration.minimumFareRules.length ? configuration.minimumFareRules.map((rule) => {
              const editing = ruleFormId === rule.id;
              const name = editing ? ruleForm.name : rule.name;
              const poiId = editing ? ruleForm.poiId : rule.poiId;
              const radius = editing ? ruleForm.radiusMiles : rule.radiusMiles;
              const minimum = editing ? ruleForm.minimumBaseFare : rule.minimumBaseFare;
              return `
                <form class="fare-settings__form fare-settings__rule-card" method="post" action="/settings/fare-settings/${category.slug}" data-fare-rule-form>
                  ${locals.csrfField || ""}
                  <input type="hidden" name="baseVersion" value="${currentVersion}" />
                  <input type="hidden" name="ruleId" value="${rule.id}" />
                  <h3>${rule.name}</h3>
                  <div class="fare-settings__fields">
                    <div class="fare-settings__field"><label for="minimum-rule-${rule.id}-name">Rule name or description</label><input id="minimum-rule-${rule.id}-name" name="name" type="text" maxlength="160" required value="${name}" aria-invalid="${editing && errors.name ? "true" : "false"}" aria-describedby="minimum-rule-${rule.id}-name-error" /><p id="minimum-rule-${rule.id}-name-error" class="fare-settings__field-error${editing && errors.name ? " fare-settings__field-error--invalid" : ""}" ${editing && errors.name ? 'role="alert"' : ""}>${editing ? errors.name || "" : ""}</p></div>
                    <div class="fare-settings__field"><label for="minimum-rule-${rule.id}-poi">Managed airport or point of interest</label><select id="minimum-rule-${rule.id}-poi" name="poiId" required aria-invalid="${editing && errors.poiId ? "true" : "false"}" aria-describedby="minimum-rule-${rule.id}-poi-error"><option value="">Select a managed location</option>${managedPois.map((poi) => `<option value="${poi.id}" ${poiId === poi.id ? "selected" : ""}>${poi.displayName} — internal ID ${poi.id}</option>`).join("")}</select><p id="minimum-rule-${rule.id}-poi-error" class="fare-settings__field-error${editing && errors.poiId ? " fare-settings__field-error--invalid" : ""}" ${editing && errors.poiId ? 'role="alert"' : ""}>${editing ? errors.poiId || "" : ""}</p></div>
                    <div class="fare-settings__field"><label for="minimum-rule-${rule.id}-radius">Radius (miles)</label><input id="minimum-rule-${rule.id}-radius" name="radiusMiles" type="number" min="0.000001" step="any" inputmode="decimal" required value="${radius}" aria-invalid="${editing && errors.radiusMiles ? "true" : "false"}" aria-describedby="minimum-rule-${rule.id}-radius-error" /><p id="minimum-rule-${rule.id}-radius-error" class="fare-settings__field-error${editing && errors.radiusMiles ? " fare-settings__field-error--invalid" : ""}" ${editing && errors.radiusMiles ? 'role="alert"' : ""}>${editing ? errors.radiusMiles || "" : ""}</p></div>
                    <div class="fare-settings__field"><label for="minimum-rule-${rule.id}-fare">Minimum base fare (GBP)</label><div class="fare-settings__currency-input"><span aria-hidden="true">£</span><input id="minimum-rule-${rule.id}-fare" name="minimumBaseFare" type="text" inputmode="decimal" pattern="(?:0|[1-9][0-9]{0,5})([.][0-9]{1,2})?" required value="${minimum}" aria-invalid="${editing && errors.minimumBaseFare ? "true" : "false"}" aria-describedby="minimum-rule-${rule.id}-fare-error" /></div><p id="minimum-rule-${rule.id}-fare-error" class="fare-settings__field-error${editing && errors.minimumBaseFare ? " fare-settings__field-error--invalid" : ""}" ${editing && errors.minimumBaseFare ? 'role="alert"' : ""}>${editing ? errors.minimumBaseFare || "" : ""}</p></div>
                  </div>
                  <div class="fare-settings__actions">
                    <button class="button button--primary" type="submit" name="ruleAction" value="save">Save rule</button>
                    <button class="button button--secondary" type="submit" name="ruleAction" value="delete" formnovalidate>Remove rule</button>
                  </div>
                </form>
              `;
            }).join("") : `<p>No minimum fare rules have been configured.</p>`}
          </section>
        ` : category.slug === "fixed-fares" ? `
          <div class="notice fare-settings__configuration-only" role="status">
            This saves configuration only. It does not decide whether a fixed fare overrides or combines with Distance Slabs and does not change booking totals. A fixed fare is directional: origin → destination. Configure the reverse journey separately if required.
          </div>
          <p class="fare-settings__help">Managed airports and other points of interest are identified by their RideMatrix internal record ID. Ordinary-address criteria use an explicitly selected UK full postcode or outward code; the chosen scope is preserved. No ambiguous formatted-address-only matching is used.</p>
          <section class="fare-settings__rule-list" aria-labelledby="fixed-fare-list-title">
            <h2 id="fixed-fare-list-title">Fixed fare records</h2>
            ${(fixedFareForms.length ? fixedFareForms : []).map((savedRule) => {
              const isNew = !savedRule.id;
              const editing = ruleFormId === savedRule.id && !isNew;
              const useSubmitted = ruleFormSubmitted && (isNew ? !ruleFormId : editing);
              const value = (key) => useSubmitted ? ruleForm[key] || "" : savedRule[key] || "";
              const heading = isNew ? "Add fixed fare" : savedRule.name;
              return `
                <form class="fare-settings__form fare-settings__rule-card" method="post" action="/settings/fare-settings/${category.slug}" data-fare-rule-form>
                  ${locals.csrfField || ""}
                  <input type="hidden" name="baseVersion" value="${currentVersion}" />
                  <input type="hidden" name="ruleId" value="${savedRule.id}" />
                  <h3>${heading || "Add fixed fare"}</h3>
                  <div class="fare-settings__fields">
                    <div class="fare-settings__field"><label for="fixed-${isNew ? "new" : savedRule.id}-name">Rule name or description</label><input id="fixed-${isNew ? "new" : savedRule.id}-name" name="name" type="text" maxlength="160" required value="${value("name")}" aria-invalid="${useSubmitted && errors.name ? "true" : "false"}" aria-describedby="fixed-${isNew ? "new" : savedRule.id}-name-error" /><p id="fixed-${isNew ? "new" : savedRule.id}-name-error" class="fare-settings__field-error${useSubmitted && errors.name ? " fare-settings__field-error--invalid" : ""}" ${useSubmitted && errors.name ? 'role="alert"' : ""}>${useSubmitted ? errors.name || "" : ""}</p></div>
                    ${["origin", "destination"].map((endpoint) => `
                      <fieldset class="fare-settings__period fare-settings__endpoint" data-fixed-endpoint>
                        <legend>${endpoint === "origin" ? "Origin" : "Destination"}</legend>
                        <div class="fare-settings__field">
                          <label for="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-type">Endpoint identification</label>
                          <select id="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-type" name="${endpoint}Type" required aria-invalid="${useSubmitted && errors[`${endpoint}Type`] ? "true" : "false"}" aria-describedby="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-type-error">
                            <option value="">Choose identification</option>
                            <option value="poi" ${value(`${endpoint}Type`) === "poi" ? "selected" : ""}>Managed POI by RideMatrix ID</option>
                            <option value="postcode" ${value(`${endpoint}Type`) === "postcode" ? "selected" : ""}>UK postcode criterion</option>
                          </select>
                          <p id="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-type-error" class="fare-settings__field-error${useSubmitted && errors[`${endpoint}Type`] ? " fare-settings__field-error--invalid" : ""}" ${useSubmitted && errors[`${endpoint}Type`] ? 'role="alert"' : ""}>${useSubmitted ? errors[`${endpoint}Type`] || "" : ""}</p>
                        </div>
                        <div class="fare-settings__field" data-endpoint-choice="poi">
                          <label for="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-poi">Managed location</label>
                          <select id="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-poi" name="${endpoint}PoiId" aria-invalid="${useSubmitted && errors[`${endpoint}PoiId`] ? "true" : "false"}" aria-describedby="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-poi-error">
                            <option value="">Select a managed location</option>
                            ${managedPois.map((poi) => `<option value="${poi.id}" ${value(`${endpoint}PoiId`) === poi.id ? "selected" : ""}>${poi.displayName} — internal ID ${poi.id}</option>`).join("")}
                          </select>
                          <p id="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-poi-error" class="fare-settings__field-error${useSubmitted && errors[`${endpoint}PoiId`] ? " fare-settings__field-error--invalid" : ""}" ${useSubmitted && errors[`${endpoint}PoiId`] ? 'role="alert"' : ""}>${useSubmitted ? errors[`${endpoint}PoiId`] || "" : ""}</p>
                        </div>
                        <div class="fare-settings__field" data-endpoint-choice="postcode">
                          <label for="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-postcode">UK postcode criterion</label>
                          <input id="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-postcode" name="${endpoint}Postcode" type="text" autocomplete="postal-code" value="${value(`${endpoint}Postcode`)}" aria-invalid="${useSubmitted && errors[`${endpoint}Postcode`] ? "true" : "false"}" aria-describedby="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-postcode-error" />
                          <p id="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-postcode-error" class="fare-settings__field-error${useSubmitted && errors[`${endpoint}Postcode`] ? " fare-settings__field-error--invalid" : ""}" ${useSubmitted && errors[`${endpoint}Postcode`] ? 'role="alert"' : ""}>${useSubmitted ? errors[`${endpoint}Postcode`] || "" : ""}</p>
                        </div>
                        <div class="fare-settings__field" data-endpoint-choice="postcode">
                          <label for="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-scope">Postcode scope</label>
                          <select id="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-scope" name="${endpoint}PostcodeScope" aria-invalid="${useSubmitted && errors[`${endpoint}PostcodeScope`] ? "true" : "false"}" aria-describedby="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-scope-error">
                            <option value="">Choose postcode scope</option>
                            <option value="full" ${value(`${endpoint}PostcodeScope`) === "full" ? "selected" : ""}>Full postcode</option>
                            <option value="outward" ${value(`${endpoint}PostcodeScope`) === "outward" ? "selected" : ""}>Outward code</option>
                          </select>
                          <p id="fixed-${isNew ? "new" : savedRule.id}-${endpoint}-scope-error" class="fare-settings__field-error${useSubmitted && errors[`${endpoint}PostcodeScope`] ? " fare-settings__field-error--invalid" : ""}" ${useSubmitted && errors[`${endpoint}PostcodeScope`] ? 'role="alert"' : ""}>${useSubmitted ? errors[`${endpoint}PostcodeScope`] || "" : ""}</p>
                        </div>
                      </fieldset>
                    `).join("")}
                    <div class="fare-settings__field"><label for="fixed-${isNew ? "new" : savedRule.id}-fare">Fixed base fare (GBP)</label><div class="fare-settings__currency-input"><span aria-hidden="true">£</span><input id="fixed-${isNew ? "new" : savedRule.id}-fare" name="baseFare" type="text" inputmode="decimal" pattern="(?:0|[1-9][0-9]{0,5})([.][0-9]{1,2})?" required value="${value("baseFare")}" aria-invalid="${useSubmitted && errors.baseFare ? "true" : "false"}" aria-describedby="fixed-${isNew ? "new" : savedRule.id}-fare-error" /></div><p id="fixed-${isNew ? "new" : savedRule.id}-fare-error" class="fare-settings__field-error${useSubmitted && errors.baseFare ? " fare-settings__field-error--invalid" : ""}" ${useSubmitted && errors.baseFare ? 'role="alert"' : ""}>${useSubmitted ? errors.baseFare || "" : ""}</p></div>
                  </div>
                  <div class="fare-settings__actions">
                    <button class="button button--primary" type="submit" name="ruleAction" value="save">${isNew ? "Add fixed fare" : "Save fixed fare"}</button>
                    ${!isNew ? `<button class="button button--secondary" type="submit" name="ruleAction" value="delete" formnovalidate>Remove fixed fare</button>` : ""}
                  </div>
                </form>
              `;
            }).join("")}
            ${configuration.fixedFares.length ? "" : `<p>No fixed fares have been configured.</p>`}
          </section>
        ` : category.slug === "distance-slabs" ? `
          <div class="notice fare-settings__configuration-only" role="status">
            This is one shared base distance-rate table for all vehicle categories. Vehicle-category uplifts are configured separately in future work. This saves configuration only; it is not a booking quote and does not calculate or change booking fares or totals.
          </div>
          <form class="fare-settings__form" method="post" action="/settings/fare-settings/${category.slug}" data-distance-slab-form>
            ${locals.csrfField || ""}
            <input type="hidden" name="baseVersion" value="${currentVersion}" />
            <input type="hidden" name="distanceSlabsSubmitted" value="yes" />
            <section class="fare-settings__period-section" aria-labelledby="distance-slabs-title">
              <h2 id="distance-slabs-title">Progressive rates by distance</h2>
              <p class="fare-settings__help">Each mile is charged at the rate for its distance band. Boundaries are start-inclusive and end-exclusive. Slabs must start at 0 miles and be contiguous; leave the final end distance blank for an open-ended rate.</p>
              ${errors.distanceSlabs ? `<p class="fare-settings__field-error fare-settings__field-error--invalid" role="alert">${errors.distanceSlabs}</p>` : ""}
              <section class="fare-settings__distance-preview" aria-labelledby="distance-preview-title">
                <h2 id="distance-preview-title">Settings preview</h2>
                <p class="fare-settings__help">This preview uses the current form values, including unsaved edits. It is not a booking quote; booking fares and totals are not calculated or changed here.</p>
                <div class="fare-settings__preview-row">
                  <div class="fare-settings__field">
                    <label for="distance-test-miles">Test distance (miles)</label>
                    <input id="distance-test-miles" name="testDistanceMiles" type="text" inputmode="decimal" data-test-distance aria-describedby="distance-test-error" />
                    <p id="distance-test-error" class="fare-settings__field-error" role="status"></p>
                  </div>
                  <p class="fare-settings__preview-total" aria-live="polite" aria-atomic="true">Calculated total (GBP): <strong data-distance-preview-total>—</strong></p>
                </div>
              </section>
              <div class="fare-settings__slab-table-wrap">
                <table class="fare-settings__slab-table">
                  <thead><tr><th scope="col">Slab</th><th scope="col">Start distance (miles)</th><th scope="col">End distance (miles)</th><th scope="col">Rate (GBP per mile)</th><th scope="col">Actions</th></tr></thead>
                  <tbody data-distance-slab-list>
                ${(configuration.distanceSlabs.length ? configuration.distanceSlabs : [{ startMiles: "", endMiles: "", ratePerMile: "" }]).map((slab, index, slabs) => {
                  const finalSlab = index === slabs.length - 1 && slab.endMiles === "";
                  return `
                    <tr data-distance-slab data-index="${index}">
                      <th scope="row" data-slab-title>Slab ${index + 1}${finalSlab ? " — open-ended final slab" : ""}</th>
                      <td><div class="fare-settings__field"><label class="visually-hidden" for="distance-slab-${index}-start">Start distance (miles)</label><input id="distance-slab-${index}-start" name="distanceSlabs[${index}][startMiles]" type="text" inputmode="decimal" value="${slab.startMiles}" aria-invalid="${errors[`distanceSlabs.${index}.startMiles`] ? "true" : "false"}" aria-describedby="distance-slab-${index}-start-error distance-slab-${index}-start-help" /><p id="distance-slab-${index}-start-error" class="fare-settings__field-error${errors[`distanceSlabs.${index}.startMiles`] ? " fare-settings__field-error--invalid" : ""}" ${errors[`distanceSlabs.${index}.startMiles`] ? 'role="alert"' : ""}>${errors[`distanceSlabs.${index}.startMiles`] || ""}</p><p id="distance-slab-${index}-start-help" class="fare-settings__help" data-slab-start-instruction hidden>Enter the distance where this new slab begins; this also sets the previous slab's end.</p></div></td>
                      <td><div class="fare-settings__field"><label class="visually-hidden" for="distance-slab-${index}-end">End distance (miles)</label><input id="distance-slab-${index}-end" name="distanceSlabs[${index}][endMiles]" type="text" inputmode="decimal" value="${slab.endMiles}" placeholder="${finalSlab ? "Open-ended" : ""}" aria-label="End distance in miles${finalSlab ? "; leave blank for open-ended final slab" : ""}" aria-invalid="${errors[`distanceSlabs.${index}.endMiles`] ? "true" : "false"}" aria-describedby="distance-slab-${index}-end-help distance-slab-${index}-end-error" /><p id="distance-slab-${index}-end-help" class="fare-settings__help" data-open-ended-note ${finalSlab ? "" : "hidden"}>Open-ended final slab — leave this blank.</p><p id="distance-slab-${index}-end-error" class="fare-settings__field-error${errors[`distanceSlabs.${index}.endMiles`] ? " fare-settings__field-error--invalid" : ""}" ${errors[`distanceSlabs.${index}.endMiles`] ? 'role="alert"' : ""}>${errors[`distanceSlabs.${index}.endMiles`] || ""}</p></div></td>
                      <td><div class="fare-settings__field"><label class="visually-hidden" for="distance-slab-${index}-rate">Rate (GBP per mile)</label><div class="fare-settings__currency-input"><span aria-hidden="true">£</span><input id="distance-slab-${index}-rate" name="distanceSlabs[${index}][ratePerMile]" type="text" inputmode="decimal" value="${slab.ratePerMile}" aria-label="Rate in pounds per mile" aria-invalid="${errors[`distanceSlabs.${index}.ratePerMile`] ? "true" : "false"}" aria-describedby="distance-slab-${index}-rate-error" /></div><p id="distance-slab-${index}-rate-error" class="fare-settings__field-error${errors[`distanceSlabs.${index}.ratePerMile`] ? " fare-settings__field-error--invalid" : ""}" ${errors[`distanceSlabs.${index}.ratePerMile`] ? 'role="alert"' : ""}>${errors[`distanceSlabs.${index}.ratePerMile`] || ""}</p></div></td>
                      <td><button class="button button--secondary button--small fare-settings__remove-slab" type="button" data-remove-distance-slab aria-label="Remove slab ${index + 1}">Remove</button></td>
                    </tr>
                  `;
                }).join("")}
                  </tbody>
                </table>
              </div>
              <button class="button button--secondary fare-settings__add-slab" type="button" data-add-distance-slab aria-describedby="distance-slab-add-error">Add distance slab</button>
              <p id="distance-slab-add-error" class="fare-settings__field-error fare-settings__field-error--invalid" data-add-distance-slab-error role="status" hidden></p>
            </section>
            ${Object.keys(errors).length ? `<div class="notice fare-settings__error" role="alert"><strong>Correct the highlighted fields before saving.</strong></div>` : ""}
            <p class="fare-settings__field-error fare-settings__field-error--invalid" data-distance-slab-submit-error role="alert" hidden></p>
            <div class="fare-settings__actions"><button class="button button--primary" type="submit">Save distance slabs</button></div>
          </form>
          <template id="fare-settings-distance-slab-template">
            <tr data-distance-slab data-index="ROW">
              <th scope="row" data-slab-title>Slab</th>
              <td><div class="fare-settings__field"><label class="visually-hidden" for="distance-slab-ROW-start">Start distance (miles)</label><input id="distance-slab-ROW-start" name="distanceSlabs[ROW][startMiles]" type="text" inputmode="decimal" aria-describedby="distance-slab-ROW-start-error distance-slab-ROW-start-help" /><p id="distance-slab-ROW-start-error" class="fare-settings__field-error"></p><p id="distance-slab-ROW-start-help" class="fare-settings__help" data-slab-start-instruction hidden>Enter the distance where this new slab begins; this also sets the previous slab's end.</p></div></td>
              <td><div class="fare-settings__field"><label class="visually-hidden" for="distance-slab-ROW-end">End distance (miles)</label><input id="distance-slab-ROW-end" name="distanceSlabs[ROW][endMiles]" type="text" inputmode="decimal" aria-label="End distance in miles" aria-describedby="distance-slab-ROW-end-help distance-slab-ROW-end-error" /><p id="distance-slab-ROW-end-help" class="fare-settings__help" data-open-ended-note hidden>Open-ended final slab — leave this blank.</p><p id="distance-slab-ROW-end-error" class="fare-settings__field-error"></p></div></td>
              <td><div class="fare-settings__field"><label class="visually-hidden" for="distance-slab-ROW-rate">Rate (GBP per mile)</label><div class="fare-settings__currency-input"><span aria-hidden="true">£</span><input id="distance-slab-ROW-rate" name="distanceSlabs[ROW][ratePerMile]" type="text" inputmode="decimal" aria-label="Rate in pounds per mile" aria-describedby="distance-slab-ROW-rate-error" /></div><p id="distance-slab-ROW-rate-error" class="fare-settings__field-error"></p></div></td>
              <td><button class="button button--secondary button--small fare-settings__remove-slab" type="button" data-remove-distance-slab>Remove</button></td>
            </tr>
          </template>
        ` : category.slug === "fare-surcharge-settings" ? `
          <form class="fare-settings__form" method="post" action="/settings/fare-settings/${category.slug}">
            ${locals.csrfField || ""}
            <input type="hidden" name="baseVersion" value="${currentVersion}" />
            <fieldset class="fare-settings__choice" aria-describedby="daily-enabled-help daily-enabled-error">
              <legend>Apply fare surcharge?</legend>
              <label><input type="radio" name="dailyEnabled" value="yes" ${configuration.dailySurcharge.enabled ? "checked" : ""} required /> Yes</label>
              <label><input type="radio" name="dailyEnabled" value="no" ${configuration.dailySurcharge.enabled ? "" : "checked"} required /> No</label>
              <p id="daily-enabled-help" class="fare-settings__help">When disabled, the recurring surcharge is not applied and saved values are retained.</p>
              <p id="daily-enabled-error" class="fare-settings__field-error${errors.dailyEnabled ? " fare-settings__field-error--invalid" : ""}" ${errors.dailyEnabled ? 'role="alert"' : ""}>${errors.dailyEnabled || ""}</p>
            </fieldset>
            <fieldset class="fare-settings__fields" data-fare-settings-details data-enabled="${configuration.dailySurcharge.enabled ? "true" : "false"}">
              <legend>Daily recurring surcharge</legend>
              <div class="fare-settings__field">
                <label for="daily-percentage">Surcharge percentage</label>
                <input id="daily-percentage" name="dailyPercentage" type="number" min="0" step="any" inputmode="decimal" value="${configuration.dailySurcharge.percentage}" aria-invalid="${errors.dailyPercentage ? "true" : "false"}" aria-describedby="daily-percentage-help daily-percentage-error" ${configuration.dailySurcharge.enabled ? "required" : "disabled"} />
                <p id="daily-percentage-help" class="fare-settings__help">Enter a non-negative percentage. No preset or business maximum is applied.</p>
                <p id="daily-percentage-error" class="fare-settings__field-error${errors.dailyPercentage ? " fare-settings__field-error--invalid" : ""}" ${errors.dailyPercentage ? 'role="alert"' : ""}>${errors.dailyPercentage || ""}</p>
              </div>
              <div class="fare-settings__field">
                <label for="daily-start-time">Start time (UK local time)</label>
                <input id="daily-start-time" name="dailyStartTime" type="time" step="60" value="${configuration.dailySurcharge.startTime}" aria-invalid="${errors.dailyStartTime ? "true" : "false"}" aria-describedby="daily-start-time-error" ${configuration.dailySurcharge.enabled ? "required" : "disabled"} />
                <p id="daily-start-time-error" class="fare-settings__field-error${errors.dailyStartTime ? " fare-settings__field-error--invalid" : ""}" ${errors.dailyStartTime ? 'role="alert"' : ""}>${errors.dailyStartTime || ""}</p>
              </div>
              <div class="fare-settings__field">
                <label for="daily-end-time">End time (UK local time)</label>
                <input id="daily-end-time" name="dailyEndTime" type="time" step="60" value="${configuration.dailySurcharge.endTime}" aria-invalid="${errors.dailyEndTime ? "true" : "false"}" aria-describedby="daily-end-time-error" ${configuration.dailySurcharge.enabled ? "required" : "disabled"} />
                <p id="daily-end-time-error" class="fare-settings__field-error${errors.dailyEndTime ? " fare-settings__field-error--invalid" : ""}" ${errors.dailyEndTime ? 'role="alert"' : ""}>${errors.dailyEndTime || ""}</p>
              </div>
              <p class="fare-settings__help fare-settings__wide">This window repeats every day, 24/7/365, including windows that cross midnight. It is start-inclusive and end-exclusive and is intended to match the scheduled service/pick-up time, not booking creation time. Start and end must differ.</p>
            </fieldset>
            ${Object.keys(errors).length ? `<div class="notice fare-settings__error" role="alert"><strong>Correct the highlighted fields before saving.</strong></div>` : ""}
            <div class="fare-settings__actions"><button class="button button--primary" type="submit">Save fare surcharge settings</button></div>
          </form>
        ` : `
          <div class="notice fare-settings__precedence" role="status">
            <strong>Saved precedence:</strong> if the scheduled service/pick-up time falls within an enabled bank holiday period, that period's surcharge takes precedence; it is not combined with the daily surcharge. Otherwise the daily window may be applicable. This is informational configuration only; no matching or fare calculation occurs here.
          </div>
          <form class="fare-settings__form" method="post" action="/settings/fare-settings/${category.slug}" data-bank-holiday-form>
            ${locals.csrfField || ""}
            <input type="hidden" name="baseVersion" value="${currentVersion}" />
            <input type="hidden" name="periodsSubmitted" value="yes" />
            <fieldset class="fare-settings__choice" aria-describedby="bank-holiday-enabled-help bank-holiday-enabled-error">
              <legend>Apply bank holiday fare surcharge?</legend>
              <label><input type="radio" name="bankHolidayEnabled" value="yes" ${configuration.bankHolidaySurcharge.enabled ? "checked" : ""} required /> Yes</label>
              <label><input type="radio" name="bankHolidayEnabled" value="no" ${configuration.bankHolidaySurcharge.enabled ? "" : "checked"} required /> No</label>
              <p id="bank-holiday-enabled-help" class="fare-settings__help">When disabled, no bank holiday surcharge is applied. Saved periods can be retained or edited.</p>
              <p id="bank-holiday-enabled-error" class="fare-settings__field-error${errors.bankHolidayEnabled ? " fare-settings__field-error--invalid" : ""}" ${errors.bankHolidayEnabled ? 'role="alert"' : ""}>${errors.bankHolidayEnabled || ""}</p>
            </fieldset>
            <section class="fare-settings__period-section" aria-labelledby="bank-holiday-periods-title">
              <h2 id="bank-holiday-periods-title">Surcharge periods</h2>
              <p class="fare-settings__help">Enter explicit local dates and times; periods are never inferred from calendars, weekdays, or holiday names. Start is inclusive and end is exclusive. Periods may cross midnight or span multiple days, but must not overlap.</p>
              ${errors.bankHolidayPeriods ? `<p class="fare-settings__field-error fare-settings__field-error--invalid" role="alert">${errors.bankHolidayPeriods}</p>` : ""}
              <div class="fare-settings__periods" data-period-list>
                ${(configuration.bankHolidaySurcharge.periods.length ? configuration.bankHolidaySurcharge.periods : [{ label: "", startDateTime: "", endDateTime: "", percentage: "" }]).map((period, index) => `
                  <fieldset class="fare-settings__period" data-period data-index="${index}" aria-labelledby="bank-period-${index}-title">
                    <legend id="bank-period-${index}-title">Period ${index + 1}</legend>
                    <div class="fare-settings__field">
                      <label for="bank-period-${index}-label">Descriptive label</label>
                      <input id="bank-period-${index}-label" name="periods[${index}][label]" type="text" maxlength="160" value="${period.label}" aria-invalid="${errors[`periods.${index}.label`] ? "true" : "false"}" aria-describedby="bank-period-${index}-label-error" />
                      <p id="bank-period-${index}-label-error" class="fare-settings__field-error${errors[`periods.${index}.label`] ? " fare-settings__field-error--invalid" : ""}" ${errors[`periods.${index}.label`] ? 'role="alert"' : ""}>${errors[`periods.${index}.label`] || ""}</p>
                    </div>
                    <div class="fare-settings__field">
                      <label for="bank-period-${index}-start">Start date and time (UK local time)</label>
                      <input id="bank-period-${index}-start" name="periods[${index}][startDateTime]" type="datetime-local" step="60" value="${period.startDateTime}" aria-invalid="${errors[`periods.${index}.startDateTime`] ? "true" : "false"}" aria-describedby="bank-period-${index}-start-error" />
                      <p id="bank-period-${index}-start-error" class="fare-settings__field-error${errors[`periods.${index}.startDateTime`] ? " fare-settings__field-error--invalid" : ""}" ${errors[`periods.${index}.startDateTime`] ? 'role="alert"' : ""}>${errors[`periods.${index}.startDateTime`] || ""}</p>
                    </div>
                    <div class="fare-settings__field">
                      <label for="bank-period-${index}-end">End date and time (UK local time)</label>
                      <input id="bank-period-${index}-end" name="periods[${index}][endDateTime]" type="datetime-local" step="60" value="${period.endDateTime}" aria-invalid="${errors[`periods.${index}.endDateTime`] ? "true" : "false"}" aria-describedby="bank-period-${index}-end-error" />
                      <p id="bank-period-${index}-end-error" class="fare-settings__field-error${errors[`periods.${index}.endDateTime`] ? " fare-settings__field-error--invalid" : ""}" ${errors[`periods.${index}.endDateTime`] ? 'role="alert"' : ""}>${errors[`periods.${index}.endDateTime`] || ""}</p>
                    </div>
                    <div class="fare-settings__field">
                      <label for="bank-period-${index}-percentage">Surcharge percentage</label>
                      <input id="bank-period-${index}-percentage" name="periods[${index}][percentage]" type="number" min="0" step="any" inputmode="decimal" value="${period.percentage}" aria-invalid="${errors[`periods.${index}.percentage`] ? "true" : "false"}" aria-describedby="bank-period-${index}-percentage-error" />
                      <p id="bank-period-${index}-percentage-error" class="fare-settings__field-error${errors[`periods.${index}.percentage`] ? " fare-settings__field-error--invalid" : ""}" ${errors[`periods.${index}.percentage`] ? 'role="alert"' : ""}>${errors[`periods.${index}.percentage`] || ""}</p>
                    </div>
                    <button class="button button--secondary button--small fare-settings__remove-period" type="button" data-remove-period>Remove period ${index + 1}</button>
                  </fieldset>
                `).join("")}
              </div>
              <button class="button button--secondary fare-settings__add-period" type="button" data-add-period>Add surcharge period</button>
            </section>
            <div class="fare-settings__actions"><button class="button button--primary" type="submit">Save bank holiday fare settings</button></div>
          </form>
          <template id="fare-settings-period-template">
            <fieldset class="fare-settings__period" data-period data-index="ROW" aria-labelledby="bank-period-ROW-title">
              <legend id="bank-period-ROW-title">Period</legend>
              <div class="fare-settings__field"><label for="bank-period-ROW-label">Descriptive label</label><input id="bank-period-ROW-label" name="periods[ROW][label]" type="text" maxlength="160" /><p class="fare-settings__field-error"></p></div>
              <div class="fare-settings__field"><label for="bank-period-ROW-start">Start date and time (UK local time)</label><input id="bank-period-ROW-start" name="periods[ROW][startDateTime]" type="datetime-local" step="60" /><p class="fare-settings__field-error"></p></div>
              <div class="fare-settings__field"><label for="bank-period-ROW-end">End date and time (UK local time)</label><input id="bank-period-ROW-end" name="periods[ROW][endDateTime]" type="datetime-local" step="60" /><p class="fare-settings__field-error"></p></div>
              <div class="fare-settings__field"><label for="bank-period-ROW-percentage">Surcharge percentage</label><input id="bank-period-ROW-percentage" name="periods[ROW][percentage]" type="number" min="0" step="any" inputmode="decimal" /><p class="fare-settings__field-error"></p></div>
              <button class="button button--secondary button--small fare-settings__remove-period" type="button" data-remove-period>Remove period</button>
            </fieldset>
          </template>
        `}
        <section class="fare-settings__history" aria-labelledby="fare-settings-history-title">
          <h2 id="fare-settings-history-title">Configuration history</h2>
          ${history.length ? `
            <ol>
              ${history.map((entry) => `<li><strong>Version ${entry.version}</strong> — ${entry.actorEmail}, ${entry.createdAt}</li>`).join("")}
            </ol>
          ` : `<p>No changes have been saved yet.</p>`}
        </section>
        <script src="/js/distance-slab-calculator.js" defer></script>
        <script src="/js/fare-settings.js" defer></script>
      `}
    </section>
  `
}) %>
