<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../partials/system-status-bar", {
      appTitle,
      systemStatus: "System settings",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>
    <%- include("../partials/header", { appTitle }) %>
    <main class="container rm-page-shell">
      <header class="new-booking-page__title">
        <h1>Email templates</h1>
        <nav aria-label="Breadcrumb"><a href="/settings">Settings</a> <span aria-hidden="true">›</span> <a href="/settings/messaging">Messaging</a> <span aria-hidden="true">›</span> <a href="/settings/messaging/email">Email</a> <span aria-hidden="true">›</span> Templates</nav>
      </header>
      <% if (notice === "saved") { %><section class="notice" role="status">Email template saved.</section><% } %>
      <section class="panel rm-card">
        <ul>
          <% templates.forEach((template) => { %>
            <li><a href="/settings/messaging/email/templates/<%= encodeURIComponent(template.eventType) %>"><%= template.eventType.replace(/_/g, " ") %></a></li>
          <% }) %>
        </ul>
        <p><a href="/settings/messaging/email">Email settings</a></p>
      </section>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
