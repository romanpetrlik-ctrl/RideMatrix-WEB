<%- include("../layouts/base", {
  title,
  appTitle,
  currentUserEmail: email,
  currentUserHref: "/account",
  pageTitle: roleLabel,
  pageMeta: "Role workspace",
  activeRoleLabel: roleLabel,
  hintsLabel: "Hints: Off",
  body: `
    <section class="panel">
      <h1>${roleLabel}</h1>
      <p><strong>Signed in as:</strong> ${email}</p>
      <p class="notice" role="status"><strong>Access granted.</strong> Granted by your current session role(s): ${grantedByLabel}.</p>
      ${module.key === "system-settings" ? `
        <div class="notice notice--warning">
          <strong>Not yet configured:</strong> Toll &amp; Fees reference data and fee settings are placeholders. POI Fees are configuration only and are not applied to booking prices or charges.
        </div>
        <nav class="system-settings-destinations" aria-label="Settings">
          <section aria-labelledby="settings-messaging-heading">
            <h2 id="settings-messaging-heading">Messaging</h2>
            <div class="system-settings-destinations__actions">
              <a class="button button--admin-cta" href="/settings/messaging">Messaging overview</a>
              <a class="button button--admin-cta" href="/settings/messaging/email">Email (On/Off)</a>
              <a class="button button--admin-cta" href="/settings/messaging/email/templates">Email templates</a>
              <a class="button button--admin-cta" href="/settings/messaging/whatsapp">WhatsApp (On/Off)</a>
              <a class="button button--admin-cta" href="/settings/messaging/whatsapp/templates">WhatsApp templates</a>
            </div>
          </section>
          <section aria-labelledby="settings-operations-heading">
            <h2 id="settings-operations-heading">Operations</h2>
            <div class="system-settings-destinations__actions">
              <a class="button button--admin-cta" href="/settings/pois">Manage POIs</a>
              <a class="button button--admin-cta" href="/settings/poi-fees">Manage POI Fees</a>
              <a class="button button--admin-cta" href="/settings/fare-settings">Fare Settings</a>
              <a class="button button--admin-cta" href="/settings/toll-fees">Toll &amp; Fees</a>
              <a class="button button--admin-cta" href="/settings/booking-integrations">Booking Integrations</a>
              <a class="button button--admin-cta" href="/settings/operator">Operator &amp; licence</a>
            </div>
          </section>
          <section aria-labelledby="settings-payments-heading">
            <h2 id="settings-payments-heading">Payments</h2>
            <div class="system-settings-destinations__actions">
              <a class="button button--admin-cta" href="/settings/payments/stripe">Stripe (On/Off)</a>
            </div>
          </section>
        </nav>
      ` : ""}
      ${module.key === "manage-vps" ? `
        <div class="notice notice--warning">
          <strong>Safety notice:</strong> reboot and recovery are placeholders and cannot execute VPS actions.
        </div>
        <p><a class="button button--execute-helper" href="/recovery">Open reboot and recovery placeholder</a></p>
      ` : ""}
    </section>
  `
}) %>
