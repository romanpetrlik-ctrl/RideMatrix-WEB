<%- include("../layouts/base", {
  title,
  appTitle,
  currentUserEmail: email,
  currentUserHref: "/account",
  pageTitle: roleLabel,
  pageMeta: "Role workspace",
  activeRoleLabel: roleLabel,
  hintsLabel: "Hints: Off",
  body: `
    <section class="panel">
      <h1>${roleLabel}</h1>
      <p><strong>Signed in as:</strong> ${email}</p>
      <p class="notice" role="status"><strong>Access granted.</strong> Granted by your current session role(s): ${grantedByLabel}.</p>
      ${module.key === "system-settings" ? `
        <div class="notice notice--warning">
          <strong>Not yet configured:</strong> Toll &amp; Fees reference data and fee settings are placeholders. They do not calculate or charge fees.
        </div>
        <p><a class="button button--primary" href="/settings/toll-fees">Open Toll &amp; Fees</a></p>
      ` : ""}
      ${module.key === "manage-vps" ? `
        <div class="notice notice--warning">
          <strong>Safety notice:</strong> reboot and recovery are placeholders and cannot execute VPS actions.
        </div>
        <p><a class="button button--execute-helper" href="/recovery">Open reboot and recovery placeholder</a></p>
      ` : ""}
    </section>
  `
}) %>
