<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../partials/system-status-bar", {
      appTitle,
      systemStatus: "System settings",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>
    <%- include("../partials/header", { appTitle }) %>
    <main class="container rm-page-shell whatsapp-booking-notification-event">
      <header class="new-booking-page__title">
        <h1><%= event.label %></h1>
        <nav aria-label="Breadcrumb">
          <a href="/settings">Settings</a> <span aria-hidden="true">›</span>
          <a href="/settings/messaging">Messaging</a> <span aria-hidden="true">›</span>
          <a href="/settings/messaging/whatsapp">WhatsApp</a> <span aria-hidden="true">›</span>
          <a href="<%= basePath %>">Templates</a> <span aria-hidden="true">›</span>
          <%= event.label %>
        </nav>
        <a href="<%= basePath %>">Back to Templates</a>
      </header>
      <% if (notice === "saved") { %><section class="notice" role="status">Notification settings saved.</section><% } %>
      <% if (error) { %><section class="notice notice--critical" role="alert"><%= error %></section><% } %>
      <section class="panel rm-card">
        <h2>Details</h2>
        <dl>
          <dt>Trigger</dt>
          <dd><%= event.trigger %></dd>
          <dt>Recipients</dt>
          <dd><%= event.recipients %></dd>
          <dt>Template parameters</dt>
          <dd>
            <ol>
              <% event.parameters.forEach((key, index) => { %>
                <li>{{<%= index + 1 %>}} — <%= parameterLabels[key] %></li>
              <% }) %>
            </ol>
          </dd>
        </dl>
        <p class="form-hint">Template content and approval are managed in Meta Business Suite.</p>
      </section>
      <section class="panel rm-card">
        <h2>Sending configuration</h2>
        <form method="post" action="<%= basePath %>/<%= encodeURIComponent(event.type) %>">
          <%- locals.csrfField || "" %>
          <div class="form-field">
            <label>
              <input type="checkbox" name="enabled" value="on" <%= setting.enabled ? "checked" : "" %>>
              Send this WhatsApp notification
            </label>
          </div>
          <div class="form-field">
            <label for="templateName">Approved Meta template name</label>
            <input id="templateName" name="templateName" type="text" maxlength="512" pattern="[a-z0-9_]+" value="<%= setting.templateName || '' %>">
          </div>
          <div class="form-field">
            <label for="templateLanguage">Template language</label>
            <input id="templateLanguage" name="templateLanguage" type="text" maxlength="12" value="<%= setting.templateLanguage %>" required>
          </div>
          <button class="button" type="submit">Save notification</button>
        </form>
        <p class="form-hint">
          <% if (setting.updatedAt) { %>Last saved <%= setting.updatedAt %><% if (setting.updatedByEmail) { %> by <%= setting.updatedByEmail %><% } %>.<% } else { %>Not saved yet. Notifications stay disabled until saved.<% } %>
        </p>
      </section>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
