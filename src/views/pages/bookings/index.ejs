<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", {
      appTitle,
      systemStatus: "System status: Healthy",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>
    <%- include("../../partials/header", { appTitle }) %>

    <main class="container rm-page-shell booking-dashboard">
      <div class="new-booking-page__title">
        <h1><%= view === "today" ? "Today's Bookings" : view === "upcoming" ? "Upcoming Bookings" : view === "all" ? "All Bookings" : view === "finished" ? "Finished Bookings" : view === "cancelled" ? "Cancelled Bookings" : view === "archived" ? "Archived Bookings" : "No-show Bookings" %></h1>
        <p>Review and manage scheduled bookings. Booking status is shown as currently recorded.</p>
        <% if (canManageStatusColors) { %><p><a href="/bookings/status-colors">Configure status colours</a></p><% } %>
      </div>

      <% if (notice === "archived") { %>
        <section class="notice" role="status">Booking archived. The booking and its price history have been retained.</section>
      <% } %>
      <% if (notice === "status-updated") { %>
        <section class="notice" role="status">Booking status updated.</section>
      <% } %>
      <% if (notice === "status-unchanged") { %>
        <section class="notice" role="status">Booking already has that status.</section>
      <% } %>
      <% if (notice === "status-not-changed") { %>
        <section class="notice" role="status">That status transition is not available for this booking.</section>
      <% } %>
      <% if (notice === "status-invalid") { %>
        <section class="notice notice--critical" role="alert">Choose a valid booking status.</section>
      <% } %>
      <% if (notice === "alert-resolved") { %>
        <section class="notice" role="status">Integration alert marked as reviewed.</section>
      <% } %>
      <% if (error) { %>
        <section class="notice notice--critical" role="alert"><%= error %></section>
      <% } %>

      <% if (integrationAlerts.length) { %>
        <section class="panel rm-card" aria-labelledby="booking-integration-alerts-title">
          <h2 id="booking-integration-alerts-title">Booking integration alerts</h2>
          <p>Review delivery, payment, and calendar issues. Marking an alert reviewed does not retry the integration.</p>
          <ul>
            <% integrationAlerts.forEach((alert) => { %>
              <li>
                <strong><a href="/bookings/<%= encodeURIComponent(alert.bookingId) %>"><%= alert.bookingReference %></a>:</strong>
                <%= alert.message %>
                <form method="post" action="/bookings/integration-alerts/<%= encodeURIComponent(alert.id) %>/resolve" class="inline-form">
                  <%- locals.csrfField || "" %>
                  <input type="hidden" name="view" value="<%= view %>">
                  <button class="button button--secondary" type="submit">Mark reviewed</button>
                </form>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <section class="panel rm-card booking-dashboard__filters" aria-label="Booking filters">
        <div class="booking-dashboard__toolbar">
        <nav class="booking-dashboard__tabs" aria-label="Booking filters">
          <% [
            ["today", "Today"],
            ["upcoming", "Upcoming"],
            ["all", "All"],
            ["finished", "Finished"],
            ["cancelled", "Cancelled"],
            ["archived", "Archived"],
            ["no-show", "No show"]
          ].forEach(([key, label]) => { %>
            <a class="button <%= view === key ? "" : "button--secondary" %>" href="/bookings?view=<%= key %><%= search ? `&search=${encodeURIComponent(search)}` : "" %>" <%= view === key ? 'aria-current="page"' : "" %>><%= label %></a>
          <% }) %>
        </nav>
        <form method="get" action="/bookings" class="booking-dashboard__search">
          <input type="hidden" name="view" value="<%= view %>">
          <div class="form-field">
            <label for="bookingSearch">Search bookings</label>
            <input id="bookingSearch" name="search" type="search" maxlength="100" value="<%= search %>" placeholder="Reference, customer, route, driver or status">
          </div>
          <button class="button button--secondary" type="submit">Search</button>
          <% if (search) { %><a href="/bookings?view=<%= view %>">Clear search</a><% } %>
        </form>
        </div>
        <p class="form-hint">Cancelled means the customer cancelled the booking. Archived bookings are removed from the working board but retained in records; archiving is not permanent deletion.</p>
      </section>

      <section class="panel rm-card booking-dashboard__results" aria-label="Booking results">
        <% if (bookings.length) { %>
          <div class="booking-dashboard__scroll">
            <div class="booking-dashboard__list">
              <div class="booking-dashboard__head" aria-hidden="true">
                <span>Booking ID</span>
                <span>Account</span>
                <span>Passenger</span>
                <span>Service date</span>
                <span>Pickup / Dropoff</span>
                <span>Payment</span>
                <span>Total fare</span>
                <span>Driver</span>
                <span>Status</span>
              </div>
              <% bookings.forEach((booking) => { %>
                <% const assignmentHref = `/customers/${encodeURIComponent(booking.customerId)}/bookings/${encodeURIComponent(booking.id)}/assignment`; %>
                <% const bookingPath = `/bookings/${encodeURIComponent(booking.id)}`; %>
                <% const terminalStatus = booking.status === "Cancelled" || booking.status === "Completed" || booking.status === "No Show"; %>
                <% const bookingKey = encodeURIComponent(booking.id); %>
                <details class="booking-dashboard__details">
                <summary class="booking-dashboard__summary" aria-controls="booking-actions-<%= bookingKey %>" style="--booking-operational-color: <%= booking.operationalColor %>; --booking-live-color: <%= booking.liveColor %>">
                  <span class="booking-dashboard__reference"><strong><%= booking.reference %></strong><% if (booking.isTestBooking) { %><span class="status-pill status-pill--critical">TEST</span><% } %></span>
                  <span class="booking-dashboard__account"><%= booking.accountType %></span>
                  <span class="booking-dashboard__passenger"><%= booking.passengerName %></span>
                  <span class="booking-dashboard__service"><%= booking.serviceDate %><%= booking.serviceTime ? ` · ${booking.serviceTime}` : "" %></span>
                  <span class="booking-dashboard__journey"><span class="booking-dashboard__stop"><%= booking.pickup %></span><span class="booking-dashboard__stop"><%= booking.dropoffAddress %></span></span>
                  <span class="booking-dashboard__payment"><%= booking.paymentLabel ?? "—" %><small><%= booking.paymentStatus || "scheduled" %></small></span>
                  <span class="booking-dashboard__fare"><%= booking.totalFareAmount ? `£${booking.totalFareAmount}` : "—" %></span>
                  <span class="booking-dashboard__assignment">
                    <% if (booking.driverName) { %>
                      <%= booking.driverName %><%= booking.vehicleRegistration ? ` · ${booking.vehicleRegistration}` : "" %>
                    <% } else { %>
                      Unassigned
                    <% } %>
                  </span>
                  <span class="booking-dashboard__status"><span class="status-pill status-pill--booking"><%= booking.archivedAt ? "Archived" : booking.status %></span><% if (booking.archivedAt) { %><small>Previously: <%= booking.status %></small><% } %><% if (booking.liveStatus) { %><small>Live: <%= booking.liveStatus %></small><% } else if (booking.driverOnline) { %><small>Driver online</small><% } %></span>
                </summary>
                        <div class="booking-dashboard__expanded" id="booking-actions-<%= bookingKey %>">
                          <div class="booking-dashboard__indicators" aria-label="Separate journey and payment statuses">
                            <span class="status-pill status-pill--booking">Payment: <%= booking.paymentStatus || "scheduled" %></span>
                            <% if (booking.paymentDueAt) { %><span>Due: <%= new Date(booking.paymentDueAt).toLocaleString("en-GB", { timeZone: "Europe/London" }) %></span><% } %>
                            <% if (booking.liveStatus) { %><span>Live: <%= booking.liveStatus %></span><% } else if (booking.driverOnline) { %><span>Driver online</span><% } %>
                            <% if (booking.extrasDescription) { %><span>Extras: <%= booking.extrasDescription %> (£<%= booking.extrasAmount %>)<%= booking.extrasPaidAt ? " — paid" : " — awaiting confirmation" %></span><% } %>
                          </div>
                          <% if (booking.archivedAt) { %>
                            <p class="form-hint">Archived booking — retained for records, not permanently deleted.<% if (booking.archiveReason) { %> Reason: <%= booking.archiveReason %><% } %></p>
                          <% } %>
                          <div class="booking-dashboard__controls">
                            <% if (!booking.archivedAt && !terminalStatus) { %>
                              <div class="booking-dashboard__action-group">
                                <a class="button button--secondary" href="<%= assignmentHref %>">Driver</a>
                                <% if (booking.driverId) { %>
                                  <form method="post" action="<%= assignmentHref %>">
                                    <%- locals.csrfField || "" %>
                                    <input type="hidden" name="action" value="unassign">
                                    <button type="submit" class="button button--secondary">Remove driver</button>
                                  </form>
                                <% } %>
                              </div>
                              <div class="booking-dashboard__action-group">
                                <% if (booking.status === "New" || booking.status === "Under availability review") { %>
                                  <% if (booking.status !== "New") { %>
                                    <form method="post" action="<%= bookingPath %>/status">
                                      <%- locals.csrfField || "" %>
                                      <input type="hidden" name="view" value="<%= view %>">
                                      <input type="hidden" name="search" value="<%= search %>">
                                      <input type="hidden" name="status" value="New">
                                      <button type="submit" class="button button--secondary">New</button>
                                    </form>
                                  <% } %>
                                  <% if (booking.status !== "Under availability review") { %>
                                    <form method="post" action="<%= bookingPath %>/status">
                                      <%- locals.csrfField || "" %>
                                      <input type="hidden" name="view" value="<%= view %>">
                                      <input type="hidden" name="search" value="<%= search %>">
                                      <input type="hidden" name="status" value="Under availability review">
                                      <button type="submit" class="button button--secondary">Review</button>
                                    </form>
                                  <% } %>
                                  <form method="post" action="<%= bookingPath %>/status">
                                    <%- locals.csrfField || "" %>
                                    <input type="hidden" name="view" value="<%= view %>">
                                    <input type="hidden" name="search" value="<%= search %>">
                                    <input type="hidden" name="status" value="Accepted">
                                    <button type="submit" class="button button--secondary">Accept</button>
                                  </form>
                                <% } else if (booking.status === "Accepted") { %>
                                  <form method="post" action="<%= bookingPath %>/status">
                                    <%- locals.csrfField || "" %>
                                    <input type="hidden" name="view" value="<%= view %>">
                                    <input type="hidden" name="search" value="<%= search %>">
                                    <input type="hidden" name="status" value="Under availability review">
                                    <button type="submit" class="button button--secondary">Review</button>
                                  </form>
                                  <form method="post" action="<%= bookingPath %>/status">
                                    <%- locals.csrfField || "" %>
                                    <input type="hidden" name="view" value="<%= view %>">
                                    <input type="hidden" name="search" value="<%= search %>">
                                    <input type="hidden" name="status" value="New">
                                    <button type="submit" class="button button--secondary">New</button>
                                  </form>
                                <% } %>
                                <% if (booking.canMarkNoShow) { %>
                                  <form method="post" action="<%= bookingPath %>/status">
                                    <%- locals.csrfField || "" %>
                                    <input type="hidden" name="view" value="<%= view %>">
                                    <input type="hidden" name="search" value="<%= search %>">
                                    <input type="hidden" name="status" value="No Show">
                                    <button type="submit" class="button button--secondary">No show</button>
                                  </form>
                                <% } %>
                              </div>
                              <% if (booking.liveStatus === "Ride finished" && (!booking.extrasAmount || booking.extrasPaidAt)) { %>
                                <form method="post" action="<%= bookingPath %>/status">
                                  <%- locals.csrfField || "" %>
                                  <input type="hidden" name="view" value="<%= view %>">
                                  <input type="hidden" name="search" value="<%= search %>">
                                  <input type="hidden" name="status" value="Completed">
                                  <button type="submit" class="button button--secondary">Complete booking</button>
                                </form>
                              <% } %>
                              <form method="post" action="<%= bookingPath %>/status" class="booking-dashboard__reason-form">
                                <%- locals.csrfField || "" %>
                                <input type="hidden" name="view" value="<%= view %>">
                                <input type="hidden" name="search" value="<%= search %>">
                                <input type="hidden" name="status" value="Cancelled">
                                <label class="visually-hidden" for="cancel-reason-<%= bookingKey %>">Cancellation reason</label>
                                <input id="cancel-reason-<%= bookingKey %>" name="reason" type="text" maxlength="500" placeholder="Cancellation reason" required>
                                <button type="submit" class="button button--secondary">Cancel</button>
                              </form>
                            <% } %>
                            <% if (!booking.archivedAt) { %>
                            <form method="post" action="<%= bookingPath %>/archive" class="booking-dashboard__reason-form">
                              <%- locals.csrfField || "" %>
                              <input type="hidden" name="view" value="<%= view %>">
                              <input type="hidden" name="search" value="<%= search %>">
                              <label class="visually-hidden" for="archive-reason-<%= bookingKey %>">Archive reason</label>
                              <input id="archive-reason-<%= bookingKey %>" name="reason" type="text" maxlength="500" placeholder="Archive reason" required>
                              <button type="submit" class="button button--secondary">Archive</button>
                            </form>
                            <% } %>
                            <a class="button button--secondary" href="<%= bookingPath %>">Details</a>
                          </div>
                </div>
              </details>
              <% }) %>
            </div>
          </div>
          <% if (bookings.length === 250) { %>
            <p class="form-hint">Showing the first 250 matching bookings. Narrow the results with search.</p>
          <% } %>
        <% } else { %>
          <div class="empty-state empty-state--compact">
            <h3>No bookings found</h3>
            <p><%= search ? "Try a different search or clear the search field." : "There are no bookings in this date range." %></p>
          </div>
        <% } %>
      </section>
    </main>
    <%- include("../../partials/footer") %>
  </body>
</html>
