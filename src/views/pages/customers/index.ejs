<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", {
      appTitle,
      systemStatus: "System status: Healthy",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>

    <%- include("../../partials/header", {
      appTitle,
      pageTitle: "Customers",
      pageMeta: "Manage customer records, contact data, and status.",
      activeRoleLabel,
      hintsLabel: `${customerCount} customers`,
      showRoleSwitch: true,
      showExitLink: true,
      contextBarPartial: "header-context/customers-list",
      contextBarData: { statusTabs, status, search, perPage, perPageOptions }
    }) %>

    <main class="container customer-list-page">
      <% if (notice) { %>
        <section class="notice notice--<%= notice.tone %>">
          <%= notice.message %>
        </section>
      <% } %>

      <section class="customer-list-page__header">
        <div>
          <p class="eyebrow">Administration / Customer management</p>
          <h1>Customer list</h1>
          <p class="customer-list-page__description">Review customer accounts, recent activity, and contact preferences from one operational workspace.</p>
        </div>
        <a class="button" href="/customers/register">New customer</a>
      </section>

      <section class="customer-list-summary" aria-label="Customer list summary">
        <div>
          <span class="customer-list-summary__label">Total customers</span>
          <strong><%= customerCount %></strong>
        </div>
        <div>
          <span class="customer-list-summary__label">In this view</span>
          <strong><%= pagination.totalRecords %></strong>
        </div>
        <div>
          <span class="customer-list-summary__label">Page</span>
          <strong><%= pagination.currentPage %> / <%= pagination.totalPages %></strong>
        </div>
      </section>

      <section class="customer-list-card">
        <div class="customer-list-card__header">
          <div>
            <h2>All customers</h2>
            <p>Sorted alphabetically by surname, then given name.</p>
          </div>
        </div>

        <% if (customers.length > 0) { %>
          <%- include("../../partials/customers-pagination", { pagination }) %>

          <div class="customers-table-wrapper">
            <table class="customers-table">
              <thead>
                <tr>
                  <th scope="col">Customer</th>
                  <th scope="col">Email</th>
                  <th scope="col">Preferred contact</th>
                  <th scope="col">Last activity</th>
                  <th scope="col">Bookings</th>
                  <th scope="col">Status</th>
                  <th scope="col" class="customers-table__actions-heading">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% customers.forEach((customer) => { %>
                  <tr>
                    <td>
                      <a class="customer-table__identity" href="<%= customer.detailHref %>">
                        <strong><%= customer.givenName %> <%= customer.surname %></strong>
                        <span><%= customer.company || customer.email || "No company or email" %></span>
                      </a>
                    </td>
                    <td><%= customer.email || "—" %></td>
                    <td><%= customer.preferredContact %></td>
                    <td>
                      <span><%= customer.formattedLastLoginAt %></span>
                      <small>Login</small>
                      <span><%= customer.formattedLastBookingAt %></span>
                      <small>Booking</small>
                    </td>
                    <td><%= customer.bookings.length %></td>
                    <td>
                      <span class="status-pill status-pill--<%= customer.status.toLowerCase().replace(/\s+/g, "-") %>"><%= customer.status %></span>
                    </td>
                    <td class="customers-table__actions">
                      <a class="button button--secondary button--small" href="<%= customer.detailHref %>">View</a>
                      <a class="button button--secondary button--small" href="<%= customer.editHref %>">Edit</a>
                      <a class="button button--danger button--small" href="<%= customer.deleteHref %>">Delete</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <%- include("../../partials/customers-pagination", { pagination }) %>
        <% } else if (hasSearchFilters) { %>
          <div class="empty-state">
            <h2>No matching customers</h2>
            <p>Try broadening the search or clearing the current status filter.</p>
            <p><a href="/customers">Clear all filters</a></p>
          </div>
        <% } else { %>
          <div class="empty-state">
            <h2>No customers yet</h2>
            <p>The customer list is empty. Use the New Customer action in the dynamic bar to start the workflow.</p>
          </div>
        <% } %>
      </section>
    </main>

    <%- include("../../partials/footer") %>
  </body>
</html>
