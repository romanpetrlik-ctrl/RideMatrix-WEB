<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", {
      appTitle,
      systemStatus: "System status: Healthy",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>

    <%- include("../../partials/header", {
      appTitle,
      contextBarPartial: "header-context/customer-detail",
      contextBarData: { customer, backToCustomersHref, isChildWindow }
    }) %>

    <main class="container rm-page-shell customer-detail-page">
      <% if (notice) { %>
        <section class="notice notice--<%= notice.tone %>">
          <%= notice.message %>
        </section>
      <% } %>

      <%- include("../../partials/customer-detail-content", { customer, mapView, mapBrowserApiKey, mapId }) %>
    </main>

    <%- include("../../partials/footer") %>
  </body>
</html>
