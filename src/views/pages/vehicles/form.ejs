<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", { appTitle, systemStatus: "System status: Healthy", currentUserEmail: null, currentUserHref: "/account" }) %>
    <%- include("../../partials/header", { appTitle }) %>
    <main class="container rm-page-shell vehicle-page"><section class="vehicle-card vehicle-form"><h1><%= title %></h1>
      <% if (errors.length) { %><div class="notice notice--critical"><% errors.forEach((error) => { %><p><%= error %></p><% }) %></div><% } %>
      <form method="post" action="<%= vehicle?.id ? `/vehicles/${encodeURIComponent(vehicle.id)}/edit` : '/vehicles/new' %>" enctype="multipart/form-data"><%- locals.csrfField || "" %>
        <div class="vehicle-form__grid">
          <section class="vehicle-form__section" aria-labelledby="vehicle-basic-heading">
            <h2 class="vehicle-form__section-heading" id="vehicle-basic-heading">Basic details</h2>
            <div class="vehicle-form__fields">
              <% const currentYear = new Date().getFullYear(); const year = vehicle?.year; const vehicleLicenseType = vehicle?.vehicleLicenseType || ""; const passengerCapacity = vehicle?.passengerCapacity; %>
              <label><span class="vehicle-form__label">Registration number</span><input name="registration" required value="<%= vehicle?.registration || '' %>"></label>
              <label><span class="vehicle-form__label">Make</span><input name="make" required value="<%= vehicle?.make || '' %>"></label>
              <label><span class="vehicle-form__label">Model</span><input name="model" required value="<%= vehicle?.model || '' %>"></label>
              <label><span class="vehicle-form__label">Fuel type <%- include("../../partials/help-button", { key: "vehicle.fuelType", helpFor }) %></span><select name="fuelType" required><% fuelTypes.forEach((item) => { %><option value="<%= item %>" <%= (vehicle?.fuelType || "ICE") === item ? "selected" : "" %>><%= item %></option><% }) %></select></label>
              <label for="passengerCapacity"><span class="vehicle-form__label">Passenger capacity <%- include("../../partials/help-button", { key: "vehicle.passengerCapacity", helpFor }) %></span><select id="passengerCapacity" name="passengerCapacity" required><option value="" <%= passengerCapacity == null || passengerCapacity < 1 || passengerCapacity > 8 ? "selected" : "" %>>Select passenger capacity</option><% for (let capacity = 1; capacity <= 8; capacity += 1) { %><option value="<%= capacity %>" <%= passengerCapacity === capacity ? "selected" : "" %>><%= capacity %></option><% } %></select></label>
              <label><span class="vehicle-form__label">Status</span><select name="status" required><% statuses.forEach((item) => { %><option value="<%= item %>" <%= (vehicle?.status || "active") === item ? "selected" : "" %>><%= item[0].toUpperCase() + item.slice(1) %></option><% }) %></select></label>
              <label><span class="vehicle-form__label">Vehicle licence type</span><select name="vehicleLicenseType" required><option value="" <%= vehicleLicenseType ? "" : "selected" %>>Select licence type</option><option value="hackney_carriage" <%= vehicleLicenseType === "hackney_carriage" ? "selected" : "" %>>Hackney Carriage</option><option value="private_hire" <%= vehicleLicenseType === "private_hire" ? "selected" : "" %>>Private Hire</option></select></label>
              <label><span class="vehicle-form__label">Vehicle licence badge number</span><input name="vehicleLicenseBadge" maxlength="64" value="<%= vehicle?.vehicleLicenseBadge || '' %>"></label>
              <label><span class="vehicle-form__label">Year of first registration</span><select name="year"><option value="" <%= year == null ? "selected" : "" %>>Not set</option><% if (year != null && (year < 2005 || year > currentYear)) { %><option value="<%= year %>" selected><%= year %> (legacy)</option><% } %><% for (let optionYear = currentYear; optionYear >= 2005; optionYear -= 1) { %><option value="<%= optionYear %>" <%= year === optionYear ? "selected" : "" %>><%= optionYear %></option><% } %></select></label>
              <label><span class="vehicle-form__label">Colour</span><input name="colour" value="<%= vehicle?.colour || '' %>"></label>
            </div>
          </section>
          <fieldset class="vehicle-form__section vehicle-form__classes" aria-labelledby="vehicle-classes-heading">
            <legend id="vehicle-classes-heading">Vehicle class assignment <%- include("../../partials/help-button", { key: "vehicle.classAssignment", helpFor }) %></legend>
            <div class="vehicle-form__options"><% classes.forEach((item) => { %><label class="vehicle-checkbox"><input type="checkbox" name="classKeys" value="<%= item.key %>" <%= vehicle?.classes?.some((assigned) => assigned.key === item.key) ? "checked" : "" %>><span><%= item.label %></span></label><% }) %></div>
          </fieldset>
          <section class="vehicle-form__section" aria-labelledby="vehicle-keeper-heading">
            <h2 class="vehicle-form__section-heading" id="vehicle-keeper-heading">Registered operator</h2>
            <label class="vehicle-form__single-field"><span class="vehicle-form__label">Registered keeper details <%- include("../../partials/help-button", { key: "vehicle.registeredKeeper", helpFor }) %></span><textarea name="registeredKeeperDetails"><%= vehicle?.registeredKeeperDetails || '' %></textarea></label>
          </section>
          <section class="vehicle-form__section" aria-labelledby="vehicle-baggage-heading">
            <h2 class="vehicle-form__section-heading" id="vehicle-baggage-heading">Baggage capacity (maximum quantity) <%- include("../../partials/help-button", { key: "vehicle.luggageCapacity", helpFor }) %></h2>
            <div class="vehicle-capacity-grid"><% baggageCategories.forEach((category) => { const existing = vehicle?.capacities?.find((capacity) => capacity.categoryKey === category.key); const capacity = existing?.maxQuantity; const helpKey = category.key === "xl_suitcase" ? "baggage.xlSuitcase" : category.key === "l_suitcase" ? "baggage.lSuitcase" : category.key === "cabin_bag" ? "baggage.cabinBag" : "baggage.backpack"; %><label><span class="vehicle-form__label"><%= category.label %> <%- include("../../partials/help-button", { key: helpKey, helpFor }) %></span><select name="capacity_<%= category.key %>"><option value="" <%= capacity == null ? "selected" : "" %>>Not set</option><% if (capacity != null && (capacity < 1 || capacity > 8)) { %><option value="<%= capacity %>" selected><%= capacity %> (legacy)</option><% } %><% for (let quantity = 1; quantity <= 8; quantity += 1) { %><option value="<%= quantity %>" <%= capacity === quantity ? "selected" : "" %>><%= quantity %></option><% } %></select></label><% }) %></div>
          </section>
          <section class="vehicle-form__section" aria-labelledby="vehicle-notes-heading">
            <h2 class="vehicle-form__section-heading" id="vehicle-notes-heading">Notes</h2>
            <label class="vehicle-form__single-field"><span class="vehicle-form__label">Vehicle notes</span><textarea name="notes"><%= vehicle?.notes || '' %></textarea></label>
          </section>
          <section class="vehicle-form__section" aria-labelledby="vehicle-documents-heading">
            <h2 class="vehicle-form__section-heading" id="vehicle-documents-heading">Vehicle documents</h2>
            <div class="vehicle-form__fields">
              <% const documentErrorsByType = documentErrors || {}; const isCreateForm = !vehicle?.id; %>
              <% (vehicleDocumentLabels || []).forEach((item) => { const existing = (documents || []).find((entry) => entry.type === item.type); const hasError = Boolean(documentErrorsByType[item.type]); %>
                <label>
                  <span class="vehicle-form__label"><%= item.label %></span>
                  <input name="<%= item.fieldName %>" type="file" accept=".pdf,.jpg,.jpeg,.png" <%= isCreateForm ? "required" : "" %>>
                  <% if (existing?.fileName) { %><span class="form-help">Uploaded: <strong><%= existing.fileName %></strong><%= existing.uploadedAt ? ` (${String(existing.uploadedAt)})` : " (selected for upload)" %></span><% } else { %><span class="form-help">No file uploaded yet.</span><% } %>
                  <% if (hasError) { %><span class="form-help notice--critical"><%= documentErrorsByType[item.type] %></span><% } %>
                </label>
              <% }) %>
            </div>
          </section>
        </div><button class="button button--primary" type="submit">Save vehicle</button> <a class="button button--secondary" href="<%= vehicle?.id ? `/vehicles/${encodeURIComponent(vehicle.id)}` : '/vehicles' %>">Cancel</a>
      </form>
    </section></main><%- include("../../partials/footer") %>
  </body>
</html>
