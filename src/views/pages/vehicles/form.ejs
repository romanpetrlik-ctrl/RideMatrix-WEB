<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", { appTitle, systemStatus: "System status: Healthy", currentUserEmail: null, currentUserHref: "/account" }) %>
    <%- include("../../partials/header", { appTitle, pageTitle: title, pageMeta: "Vehicle management", breadcrumbs: [{ label: "Vehicles", href: "/vehicles" }, { label: title }] }) %>
    <main class="container vehicle-page"><section class="vehicle-card vehicle-form"><h1><%= title %></h1>
      <% if (errors.length) { %><div class="notice notice--critical"><% errors.forEach((error) => { %><p><%= error %></p><% }) %></div><% } %>
      <form method="post" action="<%= vehicle ? `/vehicles/${vehicle.id}/edit` : '/vehicles/new' %>"><%- locals.csrfField || "" %>
        <div class="vehicle-form__grid">
          <label>Registration number<input name="registration" required value="<%= vehicle?.registration || '' %>"></label>
          <label>Make<input name="make" required value="<%= vehicle?.make || '' %>"></label>
          <label>Model<input name="model" required value="<%= vehicle?.model || '' %>"></label>
          <label><span>Fuel type <%- include("../../partials/help-button", { key: "vehicle.fuelType", helpFor }) %></span><select name="fuelType" required><% fuelTypes.forEach((item) => { %><option value="<%= item %>" <%= (vehicle?.fuelType || "ICE") === item ? "selected" : "" %>><%= item %></option><% }) %></select></label>
          <label><span>Passenger capacity <%- include("../../partials/help-button", { key: "vehicle.passengerCapacity", helpFor }) %></span><input name="passengerCapacity" type="number" min="1" step="1" required value="<%= vehicle?.passengerCapacity || '' %>"></label>
          <label>Status<select name="status" required><% statuses.forEach((item) => { %><option value="<%= item %>" <%= (vehicle?.status || "active") === item ? "selected" : "" %>><%= item[0].toUpperCase() + item.slice(1) %></option><% }) %></select></label>
          <fieldset class="vehicle-form__wide"><legend>Vehicle class assignment <%- include("../../partials/help-button", { key: "vehicle.classAssignment", helpFor }) %></legend><% classes.forEach((item) => { %><label class="vehicle-checkbox"><input type="checkbox" name="classKeys" value="<%= item.key %>" <%= vehicle?.classes?.some((assigned) => assigned.key === item.key) ? "checked" : "" %>><%= item.label %></label><% }) %></fieldset>
          <label>Colour<input name="colour" value="<%= vehicle?.colour || '' %>"></label>
          <label><span>Registered keeper details <%- include("../../partials/help-button", { key: "vehicle.registeredKeeper", helpFor }) %></span><textarea name="registeredKeeperDetails"><%= vehicle?.registeredKeeperDetails || '' %></textarea></label>
          <label class="vehicle-checkbox"><input type="checkbox" name="wheelchairAccessible" <%= vehicle?.wheelchairAccessible ? "checked" : "" %>> Wheelchair accessibility capability <%- include("../../partials/help-button", { key: "vehicle.wheelchairAccessible", helpFor }) %></label>
          <fieldset class="vehicle-form__wide"><legend>Baggage capacity (maximum quantity) <%- include("../../partials/help-button", { key: "vehicle.luggageCapacity", helpFor }) %></legend><div class="vehicle-capacity-grid"><% baggageCategories.forEach((category) => { const existing = vehicle?.capacities?.find((capacity) => capacity.categoryKey === category.key); const helpKey = category.key === "xl_suitcase" ? "baggage.xlSuitcase" : category.key === "l_suitcase" ? "baggage.lSuitcase" : category.key === "cabin_bag" ? "baggage.cabinBag" : "baggage.backpack"; %><label><span><%= category.label %> <%- include("../../partials/help-button", { key: helpKey, helpFor }) %></span><input name="capacity_<%= category.key %>" type="number" min="0" step="1" value="<%= existing?.maxQuantity ?? '' %>"></label><% }) %></div></fieldset>
          <label class="vehicle-form__wide">Notes<textarea name="notes"><%= vehicle?.notes || '' %></textarea></label>
        </div><button class="button button--primary" type="submit">Save vehicle</button> <a class="button button--secondary" href="/vehicles">Cancel</a>
      </form>
    </section></main><%- include("../../partials/footer") %>
  </body>
</html>
