<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", { appTitle, systemStatus: "System status: Healthy", currentUserEmail: email, currentUserHref: "/account" }) %>
    <%- include("../../partials/header", { appTitle, pageTitle: "Vehicles", pageMeta: "Fleet, compliance, and driver assignments.", breadcrumbs: [{ label: "Administration", href: "/dashboard" }, { label: "Vehicles" }], hintsLabel: `${total} vehicles`, showRoleSwitch: true, showExitLink: true }) %>
    <main class="container vehicle-page">
      <header class="vehicle-page__header"><div><h1>Vehicles</h1><p>Manage the fleet and its operational status.</p></div><a class="button button--primary" href="/vehicles/new">Add vehicle</a></header>
      <form class="vehicle-toolbar" method="get" action="/vehicles"><label for="vehicle-search">Search</label><input id="vehicle-search" name="q" value="<%= search %>" placeholder="Registration, make, model"><button class="button button--secondary" type="submit">Search</button></form>
      <section class="vehicle-card">
        <%- include("../../partials/vehicles-pagination", { page, totalPages, total, startRecord, endRecord, search }) %>
        <% if (vehicles.length) { %><div class="vehicle-table-wrapper"><table class="vehicle-table"><thead><tr><th>Registration</th><th>Vehicle</th><th>Class</th><th>Driver</th><th>Status</th><th>Documents</th><th></th></tr></thead><tbody>
          <% vehicles.forEach((vehicle) => { %><tr><td><a href="/vehicles/<%= vehicle.id %>"><strong><%= vehicle.registration %></strong></a></td><td><%= vehicle.make %> <%= vehicle.model %></td><td><%= vehicle.vehicleClassLabel %></td><td><%= vehicle.driverEmail || "Unassigned" %></td><td><span class="status-pill status-pill--<%= vehicle.status %>"><%= vehicle.status %></span></td><td><%= vehicle.documentsCount %></td><td><a class="button button--secondary button--small" href="/vehicles/<%= vehicle.id %>/edit">Edit</a></td></tr><% }) %>
        </tbody></table></div><% } else { %><div class="empty-state"><h2>No vehicles found</h2><p>Add a vehicle or broaden the search.</p></div><% } %>
      </section>
    </main>
    <%- include("../../partials/footer") %>
  </body>
</html>
