<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", { appTitle, systemStatus: "System status: Healthy", currentUserEmail: email, currentUserHref: "/account" }) %>
    <%- include("../../partials/header", { appTitle }) %>
    <main class="container rm-page-shell vehicle-page vehicle-list-page">
      <% const noticeMessage = new Map([["created", "Vehicle created."], ["updated", "Vehicle updated."]]).get(notice); %>
      <header class="vehicle-page__header"><div><h1><%= status === "active" ? "Active vehicles" : "Vehicles" %></h1><p><%= status === "active" ? "Vehicles currently in active service." : "Manage the fleet and its operational status." %></p></div><a class="button button--primary" href="/vehicles/new">Add vehicle</a></header>
      <% if (noticeMessage) { %><div class="notice" role="status"><%= noticeMessage %></div><% } %>
      <nav class="vehicle-status-tabs" aria-label="Vehicle status filter">
        <a href="/vehicles" aria-current="<%= status === '' ? 'page' : 'false' %>" class="button button--small <%= status === '' ? 'button--primary' : 'button--secondary' %>">All vehicles</a>
        <% statuses.forEach((item) => { %><a href="/vehicles?status=<%= item %>" aria-current="<%= status === item ? 'page' : 'false' %>" class="button button--small <%= status === item ? 'button--primary' : 'button--secondary' %>"><%= item === "active" ? "Active vehicles" : item[0].toUpperCase() + item.slice(1) %></a><% }) %>
      </nav>
      <form class="vehicle-toolbar" method="get" action="/vehicles"><label for="vehicle-search">Search</label><input id="vehicle-search" name="q" value="<%= search %>" placeholder="Registration, make, model, class"><label for="vehicle-status">Status</label><select id="vehicle-status" name="status"><option value="">All statuses</option><% statuses.forEach((item) => { %><option value="<%= item %>" <%= status === item ? "selected" : "" %>><%= item[0].toUpperCase() + item.slice(1) %></option><% }) %></select><button class="button button--secondary" type="submit">Search</button></form>
      <section class="vehicle-card">
        <%- include("../../partials/vehicles-pagination", { page, totalPages, total, startRecord, endRecord, search, status }) %>
        <% if (vehicles.length) { %><div class="vehicle-table-wrapper"><table class="vehicle-table"><thead><tr><th>Registration</th><th>Vehicle</th><th>Class assignment</th><th>Passengers</th><th>Driver</th><th>Status</th><th>Documents</th><th></th></tr></thead><tbody>
          <% vehicles.forEach((vehicle) => { %><tr><td><a href="/vehicles/<%= vehicle.id %>"><strong><%= vehicle.registration %></strong></a></td><td><%= vehicle.make %> <%= vehicle.model %></td><td><%= vehicle.classes.map((item) => item.label).join(", ") %></td><td><%= vehicle.passengerCapacity %></td><td><%= vehicle.driverEmail || "Unassigned" %></td><td><span class="status-pill status-pill--<%= vehicle.status %>"><%= vehicle.status[0].toUpperCase() + vehicle.status.slice(1) %></span></td><td><%= vehicle.documentsCount %></td><td><a class="button button--secondary button--small" href="/vehicles/<%= vehicle.id %>/edit">Edit</a></td></tr><% }) %>
        </tbody></table></div><% } else { %><div class="empty-state"><h2><%= status === "active" ? "No active vehicles found" : "No vehicles found" %></h2><p>Add a vehicle or broaden the search<%= status ? " or status filter" : "" %>.</p></div><% } %>
      </section>
    </main>
    <%- include("../../partials/footer") %>
  </body>
</html>
