<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", { appTitle, systemStatus: "System status: Healthy", currentUserEmail: email, currentUserHref: "/account" }) %>
    <%- include("../../partials/header", { appTitle }) %>
    <main class="container rm-page-shell vehicle-page vehicle-detail-page">
      <header class="vehicle-page__header"><div><h1><%= vehicle.registration %></h1><p><%= vehicle.make %> <%= vehicle.model %></p></div><div><span class="status-pill status-pill--<%= vehicle.status %>"><%= vehicle.status[0].toUpperCase() + vehicle.status.slice(1) %></span> <a class="button button--primary" href="/vehicles/<%= encodeURIComponent(vehicle.id) %>/edit">Edit</a></div></header>
      <% const noticeMessage = new Map([
        ["created", ["Vehicle created. Add compliance documents and assign a driver below.", false]],
        ["updated", ["Vehicle updated.", false]],
        ["driver-updated", ["Driver assignment saved.", false]],
        ["driver-unassigned", ["Driver unassigned from this vehicle.", false]],
        ["driver-unchanged", ["Driver assignment unchanged.", false]],
        ["driver-invalid", ["Select a valid driver account.", true]],
        ["document-added", ["Document uploaded.", false]],
        ["document-partial", ["Some files failed to upload. Review per-file status.", true]],
        ["document-upload-rejected", ["The upload batch was rejected and no files were saved.", true]],
        ["document-required", ["Choose a document type and file to upload.", true]],
        ["document-invalid-file", ["Only valid PDF, JPEG, and PNG documents are accepted.", true]],
        ["document-invalid-type", ["Select a valid compliance document type.", true]],
        ["document-invalid-expiry", ["Enter a valid current or future expiry date.", true]],
        ["document-invalid-license", ["Select a valid vehicle licence for this document.", true]],
        ["license-saved", ["Vehicle licence saved.", false]],
        ["license-invalid", ["Enter valid vehicle licence details.", true]]
      ]).get(notice); %>
      <p><a href="/vehicles">&larr; All vehicles</a> · <a href="/vehicles?status=active">Active vehicles</a></p>
      <% if (noticeMessage) { %><div class="notice<%= noticeMessage[1] ? " notice--warning" : "" %>" role="status"><%= noticeMessage[0] %></div><% } %>
      <% if ((uploadStatuses || []).length) { %>
        <div class="notice <%= uploadStatuses.some((item) => item.status === "failed") ? "notice--warning" : "" %>" role="status">
          <% uploadStatuses.forEach((item) => { %>
            <p><strong><%= item.categoryLabel ? `${item.categoryLabel} · ` : "" %><%= item.name || "File" %></strong>: <%= item.status %><%= item.reason ? ` (${item.reason})` : "" %></p>
          <% }) %>
        </div>
      <% } %>
      <section class="vehicle-detail-grid">
        <article class="vehicle-card"><h2>Vehicle information</h2><dl>
          <dt>Vehicle class assignment <%- include("../../partials/help-button", { key: "vehicle.classAssignment", helpFor }) %></dt><dd><%= vehicle.classes.map((item) => item.label).join(", ") || "—" %></dd>
          <dt>Make</dt><dd><%= vehicle.make %></dd><dt>Model</dt><dd><%= vehicle.model %></dd>
          <dt>Colour</dt><dd><%= vehicle.colour || "—" %></dd><dt>Registration number</dt><dd><%= vehicle.registration %></dd>
          <dt>Fuel type <%- include("../../partials/help-button", { key: "vehicle.fuelType", helpFor }) %></dt><dd><%= vehicle.fuelType %></dd><dt>Passenger capacity <%- include("../../partials/help-button", { key: "vehicle.passengerCapacity", helpFor }) %></dt><dd><%= vehicle.passengerCapacity %></dd>
          <dt>Basic luggage capacity <%- include("../../partials/help-button", { key: "vehicle.luggageCapacity", helpFor }) %></dt><dd><%= vehicle.capacities.map((item) => `${item.maxQuantity}${item.categoryKey === "xl_suitcase" ? "XL" : item.categoryKey === "l_suitcase" ? "L" : item.categoryKey === "cabin_bag" ? "CB" : "BP"}`).join(" + ") || "Unset" %> max</dd>
          <dt>Linked driver <%- include("../../partials/help-button", { key: "vehicle.linkedDriver", helpFor }) %></dt><dd><%= vehicle.driverDisplayName || "Unassigned" %> <% if (vehicle.driverId) { %><a href="/vehicles/<%= vehicle.id %>/driver-details">View driver details</a><% } else { %><span class="muted">View driver details unavailable until a driver is assigned.</span><% } %></dd>
          <dt>Wheelchair accessible <%- include("../../partials/help-button", { key: "vehicle.wheelchairAccessible", helpFor }) %></dt><dd><%= vehicle.wheelchairAccessible ? "Yes" : "No" %></dd><dt>Status</dt><dd><%= vehicle.status %></dd>
        </dl></article>
        <article class="vehicle-card"><h2>Vehicle documents</h2>

          <% const failedCategories = new Set((locals.failedDocumentCategories || [])); %>
          <% if (canManageVehicleDocuments) { %>
            <section class="vehicle-document-upload-workbench">
              <h3>Upload documents</h3>
              <form method="post" action="/vehicles/<%= vehicle.id %>/record-documents/upload" enctype="multipart/form-data" class="vehicle-document-form vehicle-document-form--batch-upload" id="recordDocumentBatchForm">
                <%- locals.csrfField || "" %>
                <label>Category
                  <select name="category" id="recordDocumentCategory">
                    <% (requiredDocuments || []).forEach((document) => { %>
                      <option value="<%= document.type %>"><%= document.label %></option>
                    <% }) %>
                  </select>
                </label>
                <label>Files
                  <input id="recordDocumentFiles" name="documents" type="file" accept=".pdf,.jpg,.jpeg,.png" multiple>
                </label>
                <button class="button button--secondary" type="button" id="addRecordDocumentsToQueue">Add to upload queue</button>
                <span class="form-help vehicle-document-form__helper-line">Max <%= maxFilesPerCategory %> files per category.</span>
                <span class="form-help vehicle-document-form__helper-line vehicle-document-form__helper-line--tip">Tip: select multiple files using Ctrl (Windows/Linux) or ⌘ Command (macOS) while clicking files.</span>
                <div class="vehicle-document-queue" id="recordDocumentQueue" aria-live="polite"></div>
                <div class="vehicle-document-queue-feedback" id="recordDocumentQueueFeedback" aria-live="polite"></div>
                <button class="button button--primary" type="submit" id="submitRecordDocumentQueue" disabled>Upload selected documents</button>
              </form>
            </section>
          <% } %>
          <h3>Existing documents by category</h3>

          <div class="vehicle-document-list">
            <% (requiredDocuments || []).forEach((document) => { %>
              <% const hasUploadedFiles = document.files.length > 0; %>
              <% const initialState = failedCategories.has(document.type) ? "error" : (hasUploadedFiles ? "uploaded" : "missing"); %>
              <% const initialLabel = initialState === "error" ? "Error" : (initialState === "uploaded" ? "Uploaded" : "Missing"); %>
              <% const initialIcon = initialState === "error" ? "⚠" : (initialState === "uploaded" ? "✓" : "○"); %>
              <div class="vehicle-document-row" data-document-row data-document-category="<%= document.type %>" data-initial-state="<%= initialState %>">
                <div class="vehicle-document-row__heading">
                  <strong><%= document.label %></strong>
                  <span class="document-status-badge document-status-badge--<%= initialState %>" data-status-badge>
                    <span class="document-status-badge__icon" aria-hidden="true"><%= initialIcon %></span>
                    <span data-status-label><%= initialLabel %></span>
                  </span>
                </div>
                <span>Status: <span data-status-text><%= initialLabel %></span></span>
                <% if (document.files.length) { %>
                  <% document.files.forEach((file) => { %>
                    <span>Uploaded: <strong><%= file.original_filename %></strong><%= file.uploaded_at ? ` (${String(file.uploaded_at)})` : "" %></span>
                    <% if (file.legacy) { %>
                      <span><a href="/vehicles/documents/<%= file.id %>">View</a> · <a href="/vehicles/documents/<%= file.id %>?download=1">Download</a></span>
                    <% } else { %>
                      <span><a href="/vehicles/record-documents/<%= file.id %>/view">View</a> · <a href="/vehicles/record-documents/<%= file.id %>/download">Download</a></span>
                    <% } %>
                  <% }) %>
                <% } else { %>
                  <span>Missing</span>
                <% } %>


              </div>
            <% }) %>
          </div>
        </article>
        <article class="vehicle-card"><h2>Vehicle licences</h2><p>Licence type and Vehicle licence badge belong to each authority-specific licence. They are separate from vehicle class, licence reference, and driver badge.</p>
          <% licenses.forEach((license) => { %>
            <% const isEditingLicense = editingLicenseId === license.id; %>
            <% if (isEditingLicense) { %>
              <form method="post" action="/vehicles/<%= vehicle.id %>/licenses" class="vehicle-document-form">
                <%- locals.csrfField || "" %>
                <input type="hidden" name="licenseId" value="<%= license.id %>">
                <label>Licensing authority<select name="licensingAuthorityId"><option value="" <%= license.licensingAuthorityId ? "" : "selected" %>>Not specified</option><% authorities.forEach((authority) => { %><option value="<%= authority.id %>" <%= license.licensingAuthorityId === authority.id ? "selected" : "" %>><%= authority.name %><%= authority.active ? "" : " (inactive)" %></option><% }) %></select></label>
                <label>Vehicle licence type<select name="licenseType"><option value="" <%= license.licenseType ? "" : "selected" %>>Type not set (preserve existing)</option><% licenseTypes.forEach((type) => { %><option value="<%= type %>" <%= license.licenseType === type ? "selected" : "" %>><%= type === "hackney_carriage" ? "Hackney Carriage" : "Private Hire" %></option><% }) %></select></label>
                <label>Vehicle licence badge<input name="vehicleLicenseBadge" maxlength="64" value="<%= license.vehicleLicenseBadge || '' %>" aria-label="Vehicle licence badge"></label>
                <label><input type="checkbox" name="clearVehicleLicenseBadge" value="1"> Clear current Vehicle licence badge</label>
                <label>Licence reference<input name="licenseReference" value="<%= license.licenseReference || '' %>"></label>
                <label>Valid from<input name="validFrom" type="date" required value="<%= String(license.validFrom).slice(0, 10) %>"></label>
                <label>Valid until<input name="validUntil" type="date" value="<%= license.validUntil ? String(license.validUntil).slice(0, 10) : '' %>"></label>
                <label>Notes<input name="notes" value="<%= license.notes || '' %>"></label>
                <span><%= license.active ? "Active" : "Inactive" %> · <%= license.licenseType === "hackney_carriage" ? "Hackney Carriage" : license.licenseType === "private_hire" ? "Private Hire" : "Type not set" %></span>
                <div>
                  <button class="button button--secondary" type="submit">Save licence</button>
                  <a class="button button--secondary" href="/vehicles/<%= encodeURIComponent(vehicle.id) %>">Cancel</a>
                </div>
              </form>
            <% } else { %>
              <section class="vehicle-licence-summary" aria-label="Vehicle licence">
                <dl>
                  <dt>Licensing authority</dt><dd><%= license.licensingAuthorityName || "Not specified" %></dd>
                  <dt>Vehicle licence type</dt><dd><%= license.licenseType === "hackney_carriage" ? "Hackney Carriage" : license.licenseType === "private_hire" ? "Private Hire" : "Type not set" %></dd>
                  <dt>Vehicle licence badge</dt><dd><%= license.vehicleLicenseBadge || "—" %></dd>
                  <dt>Licence reference</dt><dd><%= license.licenseReference || "—" %></dd>
                  <dt>Valid from</dt><dd><%= String(license.validFrom).slice(0, 10) %></dd>
                  <dt>Valid until</dt><dd><%= license.validUntil ? String(license.validUntil).slice(0, 10) : "—" %></dd>
                  <dt>Notes</dt><dd><%= license.notes || "—" %></dd>
                  <dt>Status</dt><dd><%= license.active ? "Active" : "Inactive" %></dd>
                </dl>
                <a class="button button--secondary" href="/vehicles/<%= encodeURIComponent(vehicle.id) %>?editLicense=<%= encodeURIComponent(license.id) %>">Edit licence</a>
              </section>
            <% } %>
          <% }) %>
          <% if (!licenses.length) { %><p>No vehicle licences recorded.</p><% } %>
          <h3>Add vehicle licence</h3><form method="post" action="/vehicles/<%= vehicle.id %>/licenses" class="vehicle-document-form"><%- locals.csrfField || "" %>
            <label>Licensing authority<select name="licensingAuthorityId"><option value="" selected>Not specified</option><% authorities.forEach((authority) => { %><option value="<%= authority.id %>"><%= authority.name %></option><% }) %></select></label>
            <label>Vehicle licence type<select name="licenseType" required><option value="">Select type</option><% licenseTypes.forEach((type) => { %><option value="<%= type %>"><%= type === "hackney_carriage" ? "Hackney Carriage" : "Private Hire" %></option><% }) %></select></label>
            <label>Vehicle licence badge<input name="vehicleLicenseBadge" maxlength="64" aria-label="Vehicle licence badge"></label>
            <label>Licence reference<input name="licenseReference"></label><label>Valid from<input name="validFrom" type="date" required></label>
            <label>Valid until<input name="validUntil" type="date"></label><label>Notes<input name="notes"></label>
            <button class="button button--secondary" type="submit">Add licence</button>
          </form>
        </article>
      </section>
      <section class="vehicle-operations"><a class="button button--secondary" href="/vehicles/<%= vehicle.id %>/bookings">Assigned bookings</a><a class="button button--secondary" href="/vehicles/<%= vehicle.id %>/driver-history">Driver assignment history</a></section>
      <% const isDriverSourceAvailable = driverSourceAvailable !== false; %>
      <section class="vehicle-card"><h2>Linked driver</h2><p class="form-help">This MVP supports one active primary driver per vehicle; a driver may be linked to multiple vehicles.</p><form method="post" action="/vehicles/<%= vehicle.id %>/driver" class="vehicle-document-form vehicle-document-form--linked-driver"><%- locals.csrfField || "" %><label for="driverId">Assigned driver</label><select id="driverId" name="driverId" <%= isDriverSourceAvailable ? "" : "disabled" %>><option value="">Unassigned</option><% drivers.forEach((driver) => { %><option value="<%= driver.id %>" <%= driver.id === vehicle.driverId ? "selected" : "" %>><%= driver.displayName || `Driver #${driver.id}` %></option><% }) %></select><button class="button button--secondary" type="submit" <%= isDriverSourceAvailable ? "" : "disabled" %>>Save assignment</button></form><% if (!isDriverSourceAvailable || !drivers.length) { %><p class="form-help">No drivers available.</p><% } %>
        <h3>Recent assignment history</h3><% if (driverAssignments.length) { %><ul class="vehicle-assignment-history"><% driverAssignments.slice(0, 5).forEach((assignment) => { %><li><strong><%= assignment.driver_display_name || `Driver #${assignment.driver_id}` %></strong> — assigned <%= assignment.assigned_at %><%= assignment.unassigned_at ? `, unassigned ${assignment.unassigned_at}` : " (current)" %></li><% }) %></ul><% } else { %><p class="muted">No driver has been assigned to this vehicle yet.</p><% } %></section>
    </main><%- include("../../partials/footer") %>

    <% if (canManageVehicleDocuments) { %>
      <script src="/js/vehicle-record-document-upload.js" defer></script>
    <% } %>
    <script>
      (() => {
        const states = {
          uploaded: { label: "Uploaded", icon: "✓" },
          missing: { label: "Missing", icon: "○" },
          pending: { label: "Pending selection", icon: "⏳" },
          error: { label: "Error", icon: "⚠" }
        };
        const rows = Array.from(document.querySelectorAll("[data-document-row]"));
        if (!rows.length) return;
        rows.forEach((row) => {
          const category = row.getAttribute("data-document-category");
          const badge = row.querySelector("[data-status-badge]");
          const badgeLabel = row.querySelector("[data-status-label]");
          const textLabel = row.querySelector("[data-status-text]");
          const badgeIcon = row.querySelector(".document-status-badge__icon");
          if (!badge || !badgeLabel || !textLabel || !badgeIcon) return;
          const initialState = row.getAttribute("data-initial-state") || "missing";
          row.dataset.baseState = initialState;
          const applyState = (stateKey) => {
            const config = states[stateKey] || states.missing;
            badge.classList.remove("document-status-badge--uploaded", "document-status-badge--missing", "document-status-badge--pending", "document-status-badge--error");
            badge.classList.add(`document-status-badge--${stateKey}`);
            badgeLabel.textContent = config.label;
            textLabel.textContent = config.label;
            badgeIcon.textContent = config.icon;
          };
          row.__applyDocumentState = applyState;
          applyState(initialState);
        });

        const categorySelect = document.getElementById("recordDocumentCategory");
        const fileInput = document.getElementById("recordDocumentFiles");
        const form = document.getElementById("recordDocumentBatchForm");
        const stagedPendingCategories = new Set();

        const getSelectionPendingCategory = () => {
          if (!(fileInput instanceof HTMLInputElement) || !(categorySelect instanceof HTMLSelectElement)) return "";
          return fileInput.files && fileInput.files.length ? String(categorySelect.value || "") : "";
        };

        const syncPendingBadges = () => {
          const pending = new Set(stagedPendingCategories);
          const selectedCategory = getSelectionPendingCategory();
          if (selectedCategory) pending.add(selectedCategory);
          rows.forEach((row) => {
            const category = row.getAttribute("data-document-category") || "";
            const baseState = row.dataset.baseState || row.getAttribute("data-initial-state") || "missing";
            const applyState = row.__applyDocumentState;
            if (typeof applyState !== "function") return;
            applyState(category && pending.has(category) ? "pending" : baseState);
          });
        };

        document.addEventListener("vehicle-record-document-queue-change", (event) => {
          const categories = Array.isArray(event.detail?.pendingCategories) ? event.detail.pendingCategories : [];
          stagedPendingCategories.clear();
          categories.forEach((category) => stagedPendingCategories.add(String(category || "")));
          syncPendingBadges();
        });

        if (fileInput instanceof HTMLInputElement) fileInput.addEventListener("change", syncPendingBadges);
        if (categorySelect instanceof HTMLSelectElement) categorySelect.addEventListener("change", syncPendingBadges);
        if (form instanceof HTMLFormElement) form.addEventListener("reset", () => window.requestAnimationFrame(syncPendingBadges));

        syncPendingBadges();
      })();
    </script>

  </body>
</html>
