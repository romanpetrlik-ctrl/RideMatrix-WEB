<%- include("../layouts/base", {
  title,
  appTitle,
  currentUserEmail: email,
  currentUserHref: "/account",
  pageTitle: "Select workspace",
  pageMeta: "Choose an internal work module.",
  activeRoleLabel: "",
  hintsLabel: "Hints: Off",
  showRoleSwitch: false,
  showExitLink: true,
  body: `
    <section class="panel panel--compact dashboard-hero">
      <p>You are signed in as <strong>${email}</strong>.</p>
    </section>

    <div class="dashboard-layout">
      <div class="workspace-tile-grid">
        ${modules
          .map(
            (module) => `
              <form method="post" action="/choose-role" class="workspace-tile-form">
                ${locals.csrfField || ""}
                <input type="hidden" name="module" value="${module.key}" />
                <button type="submit" class="workspace-tile">
                  <span class="workspace-tile__title">${module.title}</span>
                  <span class="workspace-tile__description">${module.description}</span>
                  <span class="workspace-tile__action">Open module →</span>
                </button>
              </form>
            `
          )
          .join("")}
      </div>
    </div>
  `
}) %>
