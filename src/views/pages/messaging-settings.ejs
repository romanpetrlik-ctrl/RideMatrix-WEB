<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../partials/system-status-bar", {
      appTitle,
      systemStatus: "System settings",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>
    <%- include("../partials/header", { appTitle }) %>
    <main class="container rm-page-shell">
      <header class="new-booking-page__title">
        <h1>Messaging</h1>
        <nav aria-label="Breadcrumb"><a href="/settings">Settings</a> <span aria-hidden="true">›</span> Messaging</nav>
      </header>
      <section class="panel rm-card">
        <h2>WhatsApp</h2>
        <p>Status: <strong><%= whatsapp.enabled ? "On" : "Off" %></strong></p>
        <% if (!apiConfigured) { %><p class="form-hint">API not configured.</p><% } %>
        <a class="button button--secondary" href="/settings/messaging/whatsapp">Configure WhatsApp (On/Off)</a>
      </section>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
