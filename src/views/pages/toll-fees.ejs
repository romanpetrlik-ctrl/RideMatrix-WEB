<%- include("../layouts/base", {
  title,
  appTitle,
  currentUserEmail: email,
  currentUserHref: "/account",
  pageTitle: title,
  pageMeta: "System Settings · Toll & Fees",
  activeRoleLabel: "System settings",
  hintsLabel: "Hints: Off",
  body: `
    <section class="panel toll-fees-page">
      <nav class="toll-fees-hierarchy" aria-label="Breadcrumb">
        <ol>
          ${breadcrumbs.map((crumb) => `
            <li${crumb.href ? "" : ' aria-current="page"'}>${crumb.href ? `<a href="${crumb.href}">${crumb.label.replace(/&/g, "&amp;")}</a>` : crumb.label.replace(/&/g, "&amp;")}</li>
          `).join("")}
        </ol>
      </nav>
      ${parentCrumb?.href ? `<p class="toll-fees-back"><a href="${parentCrumb.href}">&larr; Back to ${parentCrumb.label.replace(/&/g, "&amp;")}</a></p>` : ""}
      <h1>${title}</h1>
      <p class="notice toll-fees-page__access" role="status"><strong>Access granted.</strong> Granted by your current session role(s): ${grantedByLabel}.</p>

      ${!category ? `
        <p class="toll-fees-page__intro">Manage external tolls and fees. Each category keeps managed reference data separate from configurable fee schedules.</p>
        <div class="notice toll-fees-page__placeholder" role="status"><strong>Draft schedules only.</strong> Four schedules are configured as editable inactive drafts. None is used in booking prices; fees are not calculated or charged.</div>
        <nav class="toll-fees-cards" aria-label="Toll & Fees categories">
          ${categories.map((item) => `
            <a class="toll-fees-card" href="/settings/toll-fees/${item.slug}">
              <span class="toll-fees-card__title">${item.title}</span>
              <span class="toll-fees-card__description">${item.description}</span>
              <span class="toll-fees-card__action">Open category</span>
            </a>
          `).join("")}
        </nav>
      ` : category.slug === "airport-fees" ? `
        <p class="toll-fees-page__intro">${category.description}</p>
        <div class="notice toll-fees-page__placeholder" role="status">Configured airport fees are not applied to fares. Pricing integration will be added with the pricing work.</div>
        ${airportFeeSaved ? `<p class="notice airport-fees__notice" role="status">Airport and fees saved.</p>` : ""}
        ${airportFeeArchived ? `<p class="notice airport-fees__notice" role="status">Airport record archived.</p>` : ""}
        ${airportFeeFormError ? `<div class="notice airport-fees__error" role="alert">${airportFeeFormError}</div>` : ""}
        <section class="airport-fees__form-section" aria-labelledby="airport-fees-form-title">
          <h2 id="airport-fees-form-title">${airportFeeForm.id ? "Edit Airport and Fee" : "Add Airport and Fee"}</h2>
          <p>Choose the operational pickup and drop-off points separately. For Bournemouth Airport, search for Bournemouth Airport Car Park 1 for the verified operational point; the airport display name remains your choice.</p>
          ${airportFeeErrors.form ? `<div class="notice airport-fees__error" role="alert">${airportFeeErrors.form}</div>` : ""}
          ${airportFeeMapConfigured ? `
            <form class="airport-fees__form" method="post" action="${leafPath}">
              ${locals.csrfField || ""}
              <input type="hidden" name="id" value="${airportFeeForm.id}" />
              <div class="airport-fees__field">
                <label for="airport-display-name">Airport display name</label>
                <input id="airport-display-name" name="displayName" type="text" maxlength="160" required value="${airportFeeForm.displayName}" aria-invalid="${airportFeeErrors.displayName ? "true" : "false"}" aria-describedby="airport-display-name-error" />
                <p id="airport-display-name-error" class="airport-fees__field-error${airportFeeErrors.displayName ? " airport-fees__field-error--invalid" : ""}" ${airportFeeErrors.displayName ? 'role="alert"' : ""}>${airportFeeErrors.displayName || "For example, Bournemouth Airport (BOH)."}</p>
              </div>
              ${["dropoff", "pickup"].map((operation) => {
                const title = operation === "dropoff" ? "Drop-off" : "Pick-up";
                const locationId = `airport-${operation}-location`;
                const feeId = `airport-${operation}-fee`;
                const errorKey = `${operation}Location`;
                return `
                  <fieldset class="airport-fees__operation" data-airport-place-root data-airport-place-browser-key="${airportFeeMapBrowserApiKey}">
                    <legend>${title}</legend>
                    <div class="airport-fees__field">
                      <label for="${locationId}">${title} location</label>
                      <input id="${locationId}" name="${operation}LocationLabel" type="text" readonly required value="${airportFeeForm[`${operation}LocationLabel`]}" placeholder="Choose a Google Places result" aria-invalid="${airportFeeErrors[errorKey] ? "true" : "false"}" aria-describedby="${locationId}-help ${locationId}-error" />
                      <input type="hidden" name="${operation}PlaceId" value="${airportFeeForm[`${operation}PlaceId`]}" />
                      <input type="hidden" name="${operation}Latitude" value="${airportFeeForm[`${operation}Latitude`]}" />
                      <input type="hidden" name="${operation}Longitude" value="${airportFeeForm[`${operation}Longitude`]}" />
                      <div class="airport-fees__autocomplete-host" data-airport-place-autocomplete-host></div>
                      <p id="${locationId}-help" class="airport-fees__help" data-airport-place-status>Search and select a Google Places result to save its operational point.</p>
                      <p id="${locationId}-error" class="airport-fees__field-error${airportFeeErrors[errorKey] ? " airport-fees__field-error--invalid" : ""}" ${airportFeeErrors[errorKey] ? 'role="alert"' : ""}>${airportFeeErrors[errorKey] || "A Google Places selection is required."}</p>
                    </div>
                    <div class="airport-fees__field">
                      <label for="${feeId}">${title} fee (GBP)</label>
                      <div class="airport-fees__amount"><span aria-hidden="true">£</span><input id="${feeId}" name="${operation}Fee" type="number" min="0" max="999999.99" step="0.01" inputmode="decimal" required value="${airportFeeForm[`${operation}Fee`]}" aria-invalid="${airportFeeErrors[`${operation}Fee`] ? "true" : "false"}" aria-describedby="${feeId}-error" /></div>
                      <p id="${feeId}-error" class="airport-fees__field-error${airportFeeErrors[`${operation}Fee`] ? " airport-fees__field-error--invalid" : ""}" ${airportFeeErrors[`${operation}Fee`] ? 'role="alert"' : ""}>${airportFeeErrors[`${operation}Fee`] || "Enter an amount with up to 2 decimal places; £0.00 is allowed."}</p>
                    </div>
                  </fieldset>
                `;
              }).join("")}
              <div class="airport-fees__actions">
                <button class="button button--primary" type="submit">${airportFeeForm.id ? "Save airport changes" : "Save airport and fees"}</button>
                ${airportFeeForm.id ? `<a class="button button--secondary" href="${leafPath}">Cancel edit</a>` : ""}
              </div>
            </form>
            <script src="/js/google-map-preview.js" defer></script>
            <script src="/js/airport-fees.js" defer></script>
          ` : `
            <div class="notice airport-fees__error" role="alert"><strong>Google Places is unavailable.</strong> Enable Google Maps and configure a browser API key to select operational airport locations.</div>
          `}
        </section>
        <section class="airport-fees__records" aria-labelledby="airport-fees-records-title">
          <h2 id="airport-fees-records-title">Saved airports</h2>
          ${airportFeeRecords.length ? `
            <div class="airport-fees__record-list">
              ${airportFeeRecords.map((record) => `
                <article class="airport-fees__record">
                  <div class="airport-fees__record-heading">
                    <h3>${record.displayName}</h3>
                    <div class="airport-fees__actions">
                      <a class="button button--secondary button--small" href="${leafPath}?edit=${encodeURIComponent(record.id)}">Edit</a>
                      <button class="button button--secondary button--small" type="button" data-airport-delete-open="airport-delete-${record.id}">Delete</button>
                    </div>
                  </div>
                  <dl>
                    <div><dt>Drop-off</dt><dd>${record.dropoffLocationLabel} — £${record.dropoffFee}</dd></div>
                    <div><dt>Pick-up</dt><dd>${record.pickupLocationLabel} — £${record.pickupFee}</dd></div>
                  </dl>
                  <dialog id="airport-delete-${record.id}" aria-labelledby="airport-delete-title-${record.id}">
                    <form method="post" action="${leafPath}/${encodeURIComponent(record.id)}/delete">
                      ${locals.csrfField || ""}
                      <h3 id="airport-delete-title-${record.id}">Delete ${record.displayName}?</h3>
                      <p>This archives the airport record and removes it from the saved list.</p>
                      <div class="airport-fees__actions">
                        <button class="button button--primary" type="submit">Confirm delete</button>
                        <button class="button button--secondary" type="button" data-airport-delete-cancel>Cancel</button>
                      </div>
                    </form>
                  </dialog>
                </article>
              `).join("")}
            </div>
          ` : `<p>No airport records have been saved.</p>`}
        </section>
      ` : category.areas && !area ? `
        <p class="toll-fees-page__intro">${category.description}</p>
        ${category.slug === "london-lez-ulez-congestion-charge"
          ? `<div class="notice toll-fees-page__placeholder" role="status"><strong>Separate London settings.</strong> LEZ and ULEZ each have an editable draft fee schedule on their own settings page. Both drafts are inactive; fees are not calculated or charged.</div>`
          : `<div class="notice toll-fees-page__placeholder" role="status"><strong>Not configured yet.</strong> No areas have reference data or fee settings configured. Fees are not calculated or charged.</div>`}
        <nav class="toll-fees-cards" aria-label="${category.title} areas">
          ${category.areas.map((item) => `
            <a class="toll-fees-card" href="/settings/toll-fees/${category.slug}/${item.slug}">
              <span class="toll-fees-card__title">${item.title}</span>
              <span class="toll-fees-card__description">${item.description}</span>
              <span class="toll-fees-card__action">Open area</span>
            </a>
          `).join("")}
        </nav>
      ` : `
        <p class="toll-fees-page__intro">${(area ?? category).description}</p>
        <nav class="toll-fees-subnav" aria-label="${leafTitle} sections">
          <a class="toll-fees-subnav__item"${section === "reference-data" ? ' aria-current="page"' : ""} href="${leafPath}/reference-data">
            <span class="toll-fees-subnav__title">Reference data (managed)</span>
            <span class="toll-fees-subnav__description">${referenceDataDescription}</span>
            <span class="toll-fees-subnav__action">Open reference data</span>
          </a>
          <a class="toll-fees-subnav__item"${section === "fee-settings" ? ' aria-current="page"' : ""} href="${leafPath}/fee-settings">
            <span class="toll-fees-subnav__title">Fee settings</span>
            <span class="toll-fees-subnav__description">${feeSettingsDescription}</span>
            <span class="toll-fees-subnav__action">Open fee settings</span>
          </a>
        </nav>
        ${section === "reference-data" ? `
          <section class="toll-fees-detail" aria-labelledby="toll-fees-detail-title">
            <h2 id="toll-fees-detail-title">Reference data (managed)</h2>
            <p>${referenceDataDescription}</p>
            ${area?.slug === "london-lez" ? `
              <section class="london-lez-reference" aria-labelledby="london-lez-reference-title">
                <h3 id="london-lez-reference-title">${londonLezBoundaryMetadata.title}</h3>
                <p>This versioned, read-only boundary is reference data only and is separate from fee settings. It does not calculate fees or charge customers.</p>
                <dl class="london-lez-reference__metadata">
                  <div><dt>Source</dt><dd><a href="${londonLezBoundaryMetadata.sourceUrl}" rel="noreferrer">Transport for London (TfL)</a></dd></div>
                  <div><dt>Source archive</dt><dd>${londonLezBoundaryMetadata.sourceArchive}</dd></div>
                  <div><dt>Dataset version</dt><dd>${londonLezBoundaryMetadata.datasetVersion}</dd></div>
                  <div><dt>Original feature date (DATE_CREAT)</dt><dd>${londonLezBoundaryMetadata.originalFeatureDate}</dd></div>
                  <div><dt>Verification date</dt><dd>${londonLezBoundaryMetadata.verificationDate}</dd></div>
                  <div><dt>Coverage</dt><dd>London Low Emission Zone; ${londonLezBoundaryMetadata.featureCount} features</dd></div>
                  <div><dt>Coordinate systems</dt><dd>Source: ${londonLezBoundaryMetadata.sourceCoordinateSystem}; map data: ${londonLezBoundaryMetadata.displayCoordinateSystem}</dd></div>
                  <div><dt>Licence / terms</dt><dd><a href="${londonLezBoundaryMetadata.termsUrl}" rel="noreferrer">${londonLezBoundaryMetadata.licence}</a></dd></div>
                  <div><dt>Attribution</dt><dd>${londonLezBoundaryMetadata.attribution}</dd></div>
                </dl>
                ${londonLezMapConfigured ? `
                  <div
                    class="london-lez-boundary-map"
                    data-london-lez-map
                    data-map-browser-key="${londonLezMapBrowserApiKey}"
                    data-map-id="${londonLezMapId || ""}"
                    data-boundary-url="/settings/toll-fees/london-lez-ulez-congestion-charge/london-lez/reference-data/boundary.json"
                    role="region"
                    aria-label="Map of the London Low Emission Zone boundary"
                  ></div>
                  <p class="london-lez-map-status" data-london-lez-map-status role="status" aria-live="polite">Loading the London LEZ boundary preview.</p>
                  <script src="/js/google-map-preview.js" defer></script>
                  <script src="/js/london-lez-map.js" defer></script>
                ` : `
                  <div class="notice london-lez-map-status" role="status">
                    <strong>Map preview unavailable.</strong> Google Maps is not configured with an enabled browser key. The verified boundary data and source metadata are available above; no map is being shown.
                  </div>
                `}
              </section>
            ` : `
              ${area?.slug === "london-ulez" ? `
                <section class="london-lez-reference" aria-labelledby="london-ulez-reference-title">
                  <h3 id="london-ulez-reference-title">${londonUlezBoundaryMetadata.title}</h3>
                  <p>This read-only reference dataset is separate from fee settings. The source boundary geometries match the existing LEZ dataset; the ULEZ remains a distinct scheme. This reference data does not calculate fees or charge customers.</p>
                  <dl class="london-lez-reference__metadata">
                    <div><dt>Source dataset label (DATASET)</dt><dd>${londonUlezBoundaryMetadata.sourceDatasetLabels.join(", ")}</dd></div>
                    <div><dt>Source metadata (DATE_CREAT; not an effective date)</dt><dd>${londonUlezBoundaryMetadata.dateCreatedValues.join(", ")}</dd></div>
                    <div><dt>Coverage</dt><dd>London Ultra Low Emission Zone; ${londonUlezBoundaryMetadata.featureCount} features</dd></div>
                    <div><dt>Source URL</dt><dd>${londonUlezBoundaryMetadata.sourceUrl}</dd></div>
                    <div><dt>Source archive</dt><dd>${londonUlezBoundaryMetadata.sourceArchive}</dd></div>
                    <div><dt>Licence / terms</dt><dd>${londonUlezBoundaryMetadata.licence}</dd></div>
                    <div><dt>Effective date</dt><dd>${londonUlezBoundaryMetadata.effectiveDate}</dd></div>
                    <div><dt>Verification</dt><dd>${londonUlezBoundaryMetadata.verificationDate}</dd></div>
                  </dl>
                  ${londonUlezMapConfigured ? `
                    <div
                      class="london-lez-boundary-map"
                      data-london-ulez-map
                      data-map-browser-key="${londonUlezMapBrowserApiKey}"
                      data-map-id="${londonUlezMapId || ""}"
                      data-boundary-url="/settings/toll-fees/london-lez-ulez-congestion-charge/london-ulez/reference-data/boundary.json"
                      role="region"
                      aria-label="Map of the London Ultra Low Emission Zone boundary"
                    ></div>
                    <p class="london-lez-map-status" data-london-lez-map-status role="status" aria-live="polite">Loading the London ULEZ boundary preview.</p>
                    <script src="/js/google-map-preview.js" defer></script>
                    <script src="/js/london-lez-map.js" defer></script>
                  ` : `
                    <div class="notice london-lez-map-status" role="status">
                      <strong>Map preview unavailable.</strong> Google Maps is not configured with an enabled browser key. The source boundary data and metadata are available above; no map is being shown.
                    </div>
                  `}
                </section>
              ` : `
              ${area?.slug === "london-congestion-charge" ? `
                <section class="london-lez-reference" aria-labelledby="london-congestion-charge-reference-title">
                  <h3 id="london-congestion-charge-reference-title">${londonCongestionChargeBoundaryMetadata.title}</h3>
                  <p>This read-only boundary reference is separate from fee settings. It does not calculate fees or charge customers.</p>
                  <dl class="london-lez-reference__metadata">
                    <div><dt>Source URL</dt><dd>${londonCongestionChargeBoundaryMetadata.sourceUrl}</dd></div>
                    <div><dt>Source archive</dt><dd>${londonCongestionChargeBoundaryMetadata.sourceArchive}</dd></div>
                    <div><dt>Licence / terms</dt><dd>${londonCongestionChargeBoundaryMetadata.licence}</dd></div>
                    <div><dt>Effective date</dt><dd>${londonCongestionChargeBoundaryMetadata.effectiveDate}</dd></div>
                    <div><dt>Verification</dt><dd>${londonCongestionChargeBoundaryMetadata.verificationDate}</dd></div>
                    <div><dt>Coverage</dt><dd>Central London Congestion Charging Scheme; ${londonCongestionChargeBoundaryMetadata.featureCount} Polygon features</dd></div>
                  </dl>
                  <section class="london-congestion-charge-preview" aria-labelledby="london-congestion-charge-preview-title">
                    <h4 id="london-congestion-charge-preview-title">Boundary preview map</h4>
                    <p>Both supplied Polygon features are shown in this read-only map preview. GeoJSON coordinates are shown as longitude, latitude.</p>
                    ${londonCongestionChargeMapConfigured ? `
                      <div
                        class="london-lez-boundary-map"
                        data-london-congestion-charge-map
                        data-map-browser-key="${londonCongestionChargeMapBrowserApiKey}"
                        data-map-id="${londonCongestionChargeMapId || ""}"
                        data-boundary-url="/settings/toll-fees/london-lez-ulez-congestion-charge/london-congestion-charge/reference-data/boundary.json"
                        role="region"
                        aria-labelledby="london-congestion-charge-preview-title"
                        aria-describedby="london-congestion-charge-preview-summary"
                      ></div>
                      <p id="london-congestion-charge-preview-summary" class="london-lez-map-status" data-london-congestion-charge-map-status role="status" aria-live="polite">Loading the London Congestion Charge boundary preview.</p>
                      <script src="/js/google-map-preview.js" defer></script>
                      <script src="/js/london-congestion-charge-map.js" defer></script>
                    ` : `
                      <div class="notice london-lez-map-status" role="status">
                        <strong>Map preview unavailable.</strong> Google Maps is not configured with an enabled browser key. The feature count and dataset metadata remain available above.
                      </div>
                    `}
                  </section>
                </section>
              ` : `
              <div class="notice toll-fees-page__placeholder" role="status"><strong>Not configured yet.</strong> No reference dataset is configured. This area does not display maps, calculate fees, or charge customers.</div>
              `}
              `}
            `}
          </section>
        ` : section === "fee-settings" ? `
          <section class="toll-fees-detail" aria-labelledby="toll-fees-detail-title">
            <h2 id="toll-fees-detail-title">Fee settings</h2>
            <p>Edit the draft schedule below. Rate conditions and reference information are available alongside the rates.</p>
            ${feeScheduleSnapshot ? `
              <section class="london-fee-draft" aria-labelledby="london-fee-draft-title">
                <h3 id="london-fee-draft-title">${feeScheduleSnapshot.schedule.title} draft schedule</h3>
                <div class="notice london-fee-draft__status" role="status"><strong>Draft / Inactive — not used for booking prices</strong></div>
                <p class="london-fee-draft__intro">This draft does not calculate fees or charge customers. Changes do not affect estimates, bookings, invoices, notifications, or customer charges. Saving records a new history version; this schedule cannot be activated here.</p>
                ${feeScheduleSaved ? `<p class="notice london-fee-draft__saved" role="status">Draft changes saved as version ${feeScheduleSnapshot.currentVersion}.</p>` : ""}
                ${feeScheduleFormError ? `<div class="notice london-fee-draft__error" role="alert">${feeScheduleFormError}</div>` : ""}
                <form class="london-fee-draft__form" method="post" action="${leafPath}/fee-settings">
                  ${locals.csrfField || ""}
                  <input type="hidden" name="baseVersion" value="${feeScheduleSnapshot.currentVersion}" />
                  <div class="london-fee-draft__rates">
                    ${feeScheduleSnapshot.schedule.rates.map((rate) => {
                      const isCrossing = feeScheduleSnapshot.schedule.kind === "crossing";
                      const amountValue = Object.prototype.hasOwnProperty.call(submittedAmounts, rate.key)
                        ? submittedAmounts[rate.key]
                        : typeof rate.amount === "number" ? rate.amount.toFixed(2) : rate.amount;
                      const errorId = `london-fee-error-${rate.key}`;
                      return `
                        <fieldset class="london-fee-draft__rate">
                          <legend>${isCrossing ? `${rate.vehicleClass} — ${rate.paymentMethod}` : rate.label}</legend>
                          <label for="london-fee-amount-${rate.key}">${isCrossing ? "Amount (GBP per crossing)" : "Daily rate (GBP per charging day)"}</label>
                          <div class="london-fee-draft__amount">
                            <span aria-hidden="true">£</span>
                            <input
                              id="london-fee-amount-${rate.key}"
                              name="amount_${rate.key}"
                              type="number"
                              min="${isCrossing && feeScheduleSnapshot.schedule.kind === "crossing" && feeScheduleSnapshot.schedule.allowZeroAmounts ? "0" : "0.01"}"
                              max="999999.99"
                              step="0.01"
                              inputmode="decimal"
                              required
                              value="${amountValue}"
                              aria-invalid="${feeScheduleErrors[rate.key] ? "true" : "false"}"
                              aria-describedby="${errorId}"
                            />
                          </div>
                          <p id="${errorId}" class="london-fee-draft__field-error${feeScheduleErrors[rate.key] ? " london-fee-draft__field-error--invalid" : ""}" ${feeScheduleErrors[rate.key] ? 'role="alert"' : ""}>${feeScheduleErrors[rate.key] || (isCrossing && feeScheduleSnapshot.schedule.kind === "crossing" && feeScheduleSnapshot.schedule.allowZeroAmounts ? "Enter a GBP amount from £0.00 with up to 2 decimal places." : "Enter a positive GBP amount with up to 2 decimal places.")}</p>
                          <details class="london-fee-draft__conditions">
                            <summary>Rate conditions</summary>
                            ${isCrossing && feeScheduleSnapshot.schedule.kind === "crossing" ? `
                              <dl>
                                <div><dt>Vehicle class/type</dt><dd>${rate.vehicleClass}</dd></div>
                                <div><dt>Payment method</dt><dd>${rate.paymentMethod}</dd></div>
                                <div><dt>Chargeable time</dt><dd>${rate.chargingPeriod}</dd></div>
                                <div><dt>Applicability</dt><dd>${rate.applicability}</dd></div>
                                <div><dt>Crossing basis</dt><dd>${rate.crossingBasis}</dd></div>
                              </dl>
                            ` : `
                              <dl>
                                <div><dt>Charging period</dt><dd>${rate.chargingPeriod}</dd></div>
                                <div><dt>Applicability</dt><dd>${rate.applicability}</dd></div>
                                <div><dt>Emissions threshold</dt><dd>${rate.emissionsThresholds}</dd></div>
                              </dl>
                            `}
                          </details>
                        </fieldset>
                      `;
                    }).join("")}
                  </div>
                  <div class="london-fee-draft__actions">
                    <button class="button button--primary" type="submit">Save draft rates</button>
                  </div>
                </form>

                <section class="london-fee-draft__details" aria-labelledby="london-fee-draft-details-title">
                  <h4 id="london-fee-draft-details-title">Schedule conditions and provenance</h4>
                  <dl>
                    <div><dt>Status</dt><dd>Draft / Inactive</dd></div>
                    <div><dt>Currency</dt><dd>GBP</dd></div>
                    <div><dt>Charging period</dt><dd>${feeScheduleSnapshot.schedule.chargingPeriod}</dd></div>
                    <div><dt>Effective date</dt><dd>Unknown / unverified; not supplied.</dd></div>
                    <div><dt>Discount and exemption rules</dt><dd>Unknown / unverified; complete rules were not supplied.</dd></div>
                    <div><dt>Source / provenance</dt><dd>${feeScheduleSnapshot.schedule.provenance}</dd></div>
                    ${feeScheduleSnapshot.schedule.sources.map((source) => `
                      <div><dt>Source: ${source.label}</dt><dd>${source.url ? `<a href="${source.url.replace(/&/g, "&amp;")}" rel="noreferrer">${source.url.replace(/&/g, "&amp;")}</a>` : "URL not provided; unknown."}</dd></div>
                    `).join("")}
                  </dl>
                  <h4>Operating rules</h4>
                  <ul>${feeScheduleSnapshot.schedule.operatingRules.map((rule) => `<li>${rule}</li>`).join("")}</ul>
                  ${feeScheduleSnapshot.schedule.kind === "crossing" && feeScheduleSnapshot.schedule.eligibilityNotes.length ? `
                    <h4>Eligibility notes (not applied)</h4>
                    <ul>${feeScheduleSnapshot.schedule.eligibilityNotes.map((note) => `<li>${note}</li>`).join("")}</ul>
                  ` : ""}
                  ${feeScheduleSnapshot.schedule.kind === "london_daily" && feeScheduleSnapshot.schedule.nonChargeableCategories.length ? `
                    <h4>Not charged under the supplied text</h4>
                    <ul>${feeScheduleSnapshot.schedule.nonChargeableCategories.map((item) => `<li><strong>${item.label}:</strong> ${item.applicability} ${item.emissionsThresholds}</li>`).join("")}</ul>
                  ` : ""}
                  ${feeScheduleSnapshot.schedule.scheme === "london-ulez" ? `<p>ULEZ enforcement penalties are not fee rates and are not included in this schedule.</p>` : ""}
                </section>

                <section class="london-fee-draft__history" aria-labelledby="london-fee-history-title">
                  <h4 id="london-fee-history-title">Draft version history</h4>
                  <ol>
                    ${escapedFeeScheduleHistory.map((record) => `<li><strong>Version ${record.version}</strong> — ${record.actorEmail} — ${record.createdAt}</li>`).join("")}
                  </ol>
                </section>
              </section>
            ` : `<div class="notice toll-fees-page__placeholder" role="status"><strong>Not configured yet.</strong> No fee schedule is configured. This area does not calculate fees or charge customers.</div>`}
          </section>
        ` : `
          ${area?.slug === "london-lez" || area?.slug === "london-ulez"
            ? `<div class="notice toll-fees-page__placeholder" role="status"><strong>Draft fee schedule available.</strong> This scheme has an editable Draft / Inactive fee schedule on its Fee settings page. The draft is not used for booking prices and does not calculate or charge fees.</div>`
            : category?.slug === "dartford-crossing" || category?.slug === "blackwall-silvertown-tunnels"
              ? `<div class="notice toll-fees-page__placeholder" role="status"><strong>Draft fee schedule available.</strong> This crossing scheme has an editable Draft / Inactive fee schedule on its Fee settings page. It is not used for booking prices and does not calculate or charge fees.</div>`
            : area?.slug === "london-congestion-charge"
              ? `<div class="notice toll-fees-page__placeholder" role="status"><strong>Reference data and fee settings are separate.</strong> The boundary reference is available on its Reference data page. No Congestion Charge fee schedule is configured; fees are not calculated or charged.</div>`
              : `<div class="notice toll-fees-page__placeholder" role="status"><strong>Not configured yet.</strong> Both reference data and fee settings are placeholders. They do not calculate or charge fees.</div>`}
        `}
      `}
    </section>
  `
}) %>
