<%- include("../layouts/base", {
  title,
  appTitle,
  currentUserEmail: email,
  currentUserHref: "/account",
  pageTitle: title,
  pageMeta: "System Settings · Toll & Fees",
  activeRoleLabel: "System settings",
  hintsLabel: "Hints: Off",
  body: `
    <section class="panel toll-fees-page">
      <nav class="toll-fees-hierarchy" aria-label="Breadcrumb">
        <ol>
          ${breadcrumbs.map((crumb) => `
            <li${crumb.href ? "" : ' aria-current="page"'}>${crumb.href ? `<a href="${crumb.href}">${crumb.label.replace(/&/g, "&amp;")}</a>` : crumb.label.replace(/&/g, "&amp;")}</li>
          `).join("")}
        </ol>
      </nav>
      ${parentCrumb?.href ? `<p class="toll-fees-back"><a href="${parentCrumb.href}">&larr; Back to ${parentCrumb.label.replace(/&/g, "&amp;")}</a></p>` : ""}
      <h1>${title}</h1>
      <p class="notice toll-fees-page__access" role="status"><strong>Access granted.</strong> Granted by your current session role(s): ${grantedByLabel}.</p>

      ${!category ? `
        <p class="toll-fees-page__intro">Manage external tolls and fees. Each category keeps managed reference data separate from configurable fee schedules.</p>
        <div class="notice toll-fees-page__placeholder" role="status"><strong>Not configured yet.</strong> No toll or fee reference data or schedules are configured here. Fees are not calculated or charged.</div>
        <nav class="toll-fees-cards" aria-label="Toll & Fees categories">
          ${categories.map((item) => `
            <a class="toll-fees-card" href="/settings/toll-fees/${item.slug}">
              <span class="toll-fees-card__title">${item.title}</span>
              <span class="toll-fees-card__description">${item.description}</span>
              <span class="toll-fees-card__action">Open category</span>
            </a>
          `).join("")}
        </nav>
      ` : category.areas && !area ? `
        <p class="toll-fees-page__intro">${category.description}</p>
        <div class="notice toll-fees-page__placeholder" role="status"><strong>Not configured yet.</strong> No areas have reference data or fee settings configured. Fees are not calculated or charged.</div>
        <nav class="toll-fees-cards" aria-label="${category.title} areas">
          ${category.areas.map((item) => `
            <a class="toll-fees-card" href="/settings/toll-fees/${category.slug}/${item.slug}">
              <span class="toll-fees-card__title">${item.title}</span>
              <span class="toll-fees-card__description">${item.description}</span>
              <span class="toll-fees-card__action">Open area</span>
            </a>
          `).join("")}
        </nav>
      ` : `
        <p class="toll-fees-page__intro">${(area ?? category).description}</p>
        <nav class="toll-fees-subnav" aria-label="${leafTitle} sections">
          <a class="toll-fees-subnav__item"${section === "reference-data" ? ' aria-current="page"' : ""} href="${leafPath}/reference-data">
            <span class="toll-fees-subnav__title">Reference data (managed)</span>
            <span class="toll-fees-subnav__description">${referenceDataDescription}</span>
            <span class="toll-fees-subnav__action">Open reference data</span>
          </a>
          <a class="toll-fees-subnav__item"${section === "fee-settings" ? ' aria-current="page"' : ""} href="${leafPath}/fee-settings">
            <span class="toll-fees-subnav__title">Fee settings</span>
            <span class="toll-fees-subnav__description">${feeSettingsDescription}</span>
            <span class="toll-fees-subnav__action">Open fee settings</span>
          </a>
        </nav>
        ${section === "reference-data" ? `
          <section class="toll-fees-detail" aria-labelledby="toll-fees-detail-title">
            <h2 id="toll-fees-detail-title">Reference data (managed)</h2>
            <p>${referenceDataDescription}</p>
            <div class="notice toll-fees-page__placeholder" role="status"><strong>Not configured yet.</strong> No reference dataset is configured. This area does not display maps, calculate fees, or charge customers.</div>
          </section>
        ` : section === "fee-settings" ? `
          <section class="toll-fees-detail" aria-labelledby="toll-fees-detail-title">
            <h2 id="toll-fees-detail-title">Fee settings</h2>
            <p>${feeSettingsDescription}</p>
            <div class="notice toll-fees-page__placeholder" role="status"><strong>Not configured yet.</strong> No fee schedule is configured. This area does not calculate fees or charge customers.</div>
          </section>
        ` : `
          <div class="notice toll-fees-page__placeholder" role="status"><strong>Not configured yet.</strong> Both reference data and fee settings are placeholders. They do not calculate or charge fees.</div>
        `}
      `}
    </section>
  `
}) %>
