<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", {
      appTitle,
      systemStatus: "System status: Healthy",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>

    <%- include("../../partials/header", {
      appTitle
    }) %>

    <main class="container rm-page-shell staff-page staff-list-page">
      <div class="staff-page__header">
        <div class="staff-page__heading">
          <p class="staff-page__eyebrow">Administration</p>
          <h1 class="staff-page__title">Staff directory</h1>
          <p class="staff-page__subtitle">
            Internal users with an administrative, dispatch, technical, or driving role.
          </p>
        </div>
        <div class="staff-page__actions">
          <a class="button button--execute staff-button staff-button--primary" href="/staff/invite">Create / Invite user</a>
        </div>
      </div>

      <section class="staff-stats" aria-label="Staff list summary">
        <div class="staff-stat-card">
          <span class="staff-stat-card__label">Total staff</span>
          <strong class="staff-stat-card__value"><%= staffCount %></strong>
          <span class="staff-stat-card__hint">Active internal accounts</span>
        </div>
      </section>

      <section class="staff-card" aria-labelledby="staff-directory-heading">
        <header class="staff-card__header">
          <div>
            <h2 class="staff-card__title" id="staff-directory-heading"><%= staffCount %> staff record<%= staffCount === 1 ? "" : "s" %></h2>
            <p class="staff-card__subtitle">Sorted alphabetically by email address.</p>
            <p class="staff-card__subtitle" id="staff-login-history-hint">Select an email address to view that account's login history.</p>
            <p class="staff-card__subtitle" id="staff-details-hint">Double-click a row or select View details to open user details and login history.</p>
          </div>
        </header>

        <% if (staff.length > 0) { %>
          <div class="staff-table-wrapper">
            <table class="staff-table">
              <thead>
                <tr>
                  <th scope="col">Email</th>
                  <th scope="col">Status</th>
                  <th scope="col">Roles</th>
                  <th scope="col" class="staff-table__cell--date">Created</th>
                  <th scope="col" class="staff-table__cell--date">Last login</th>
                  <th scope="col">Details</th>
                </tr>
              </thead>
              <tbody>
                <% staff.forEach((member) => { %>
                  <tr data-staff-row>
                    <th scope="row" class="staff-table__identity">
                      <span class="staff-table__avatar" aria-hidden="true"><%= member.email.charAt(0).toUpperCase() %></span>
                      <a class="staff-table__email staff-table__email-link" href="<%= member.auditHref %>" aria-describedby="staff-login-history-hint"><%= member.email %></a>
                    </th>
                    <td data-label="Status">
                      <% if (member.status) { %>
                        <span class="status-pill status-pill--<%= member.status.toLowerCase().replace(/\s+/g, "-") %>"><%= member.status %></span>
                      <% } else { %>
                        <span class="staff-table__muted">—</span>
                      <% } %>
                    </td>
                    <td data-label="Roles">
                      <% const roleBadges = member.roleBadges || member.roleLabels.map((label) => ({ label, isSuperuser: false })); %>
                      <% if (roleBadges.length > 0) { %>
                        <ul class="staff-role-badges">
                          <% roleBadges.forEach((badge) => { %>
                            <% if (badge.isSuperuser) { %>
                              <li><span class="staff-role-badge staff-role-badge--superuser" data-staff-superuser title="Superuser: full system access"><abbr title="Superuser">SU</abbr> · <%= badge.label %></span></li>
                            <% } else { %>
                              <li><span class="staff-role-badge"><%= badge.label %></span></li>
                            <% } %>
                          <% }) %>
                        </ul>
                      <% } else { %>
                        <span class="staff-table__muted">—</span>
                      <% } %>
                    </td>
                    <td data-label="Created" class="staff-table__cell--date"><%= member.formattedCreatedAt %></td>
                    <td data-label="Last login" class="staff-table__cell--date"><%= member.formattedLastLoginAt %></td>
                    <td data-label="Details">
                      <a class="staff-button" href="<%= member.auditHref %>" data-staff-details aria-describedby="staff-details-hint">View details</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="staff-empty-state">
            <h2 class="staff-empty-state__title"><%= staffCount %> staff records</h2>
            <p class="staff-empty-state__text">No internal staff accounts are available.</p>
            <a class="button button--execute staff-button staff-button--primary" href="/staff/invite">Create / Invite user</a>
          </div>
        <% } %>
      </section>
    </main>

    <dialog class="staff-details-dialog" id="staff-details-dialog" aria-labelledby="staff-details-title">
      <header class="staff-details-dialog__header">
        <h2 id="staff-details-title">User details and login history</h2>
        <button class="staff-button" type="button" data-staff-details-close autofocus>Close</button>
      </header>
      <iframe title="Selected staff user details and login history" referrerpolicy="no-referrer" sandbox="allow-same-origin"></iframe>
    </dialog>
    <script src="/js/staff-details.js" defer></script>
    <%- include("../../partials/footer") %>
  </body>
</html>
