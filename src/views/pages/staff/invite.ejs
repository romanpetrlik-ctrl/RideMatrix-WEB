<!DOCTYPE html>
<html lang="en">
  <%- include("../../partials/head", { title, appTitle }) %>
  <body>
    <%- include("../../partials/system-status-bar", {
      appTitle,
      systemStatus: "System status: Healthy",
      currentUserEmail: email,
      currentUserHref: "/account"
    }) %>

    <%- include("../../partials/header", {
      appTitle,
      pageTitle: "Create / Invite user",
      pageMeta: "Internal staff account administration",
      activeRoleLabel: "Staff",
      breadcrumbs: [
        { label: "Administration", href: "/dashboard" },
        { label: "Staff", href: "/staff" },
        { label: "Create / Invite user" }
      ],
      hintsLabel: "Staff administration",
      showRoleSwitch: true,
      showExitLink: true
    }) %>

    <main class="container staff-page staff-invite-page">
      <div class="staff-page__header">
        <div class="staff-page__heading">
          <p class="staff-page__eyebrow">Staff administration</p>
          <h1 class="staff-page__title">Create / Invite user</h1>
          <p class="staff-page__subtitle">
            Create an internal account and delegate the workspaces it may use. No credentials are set or
            shown here: the invited account signs in through the existing access-request flow.
          </p>
        </div>
        <div class="staff-page__actions">
          <a class="staff-button staff-button--ghost" href="/staff">Back to staff directory</a>
        </div>
      </div>

      <% if (success) { %>
        <section class="staff-notice staff-notice--success" role="status">
          <strong class="staff-notice__title">Account created for <%= success.email %>.</strong>
          <p class="staff-notice__text">Assigned roles: <%= success.roleLabels.join(", ") %>.</p>
          <% if (success.invitationSent) { %>
            <p class="staff-notice__text">An access link / login code has been requested for this address through the standard access flow.</p>
          <% } else { %>
            <p class="staff-notice__text">
              Invitation pending: access link or login code delivery is not configured in this environment.
              The account can still sign in through the standard access request at <a href="/access">/access</a>.
            </p>
          <% } %>
        </section>
      <% } %>

      <% if (errors.length > 0) { %>
        <section class="staff-notice staff-notice--critical" role="alert">
          <strong class="staff-notice__title">Please correct the following errors:</strong>
          <ul class="staff-notice__list">
            <% errors.forEach((err) => { %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <section class="staff-card staff-form-card">
        <form class="staff-form" method="post" action="/staff/invite">
          <%- locals.csrfField || "" %>

          <div class="staff-form__section">
            <h2 class="staff-form__section-title">Account</h2>
            <div class="staff-field">
              <label class="staff-field__label" for="email">Email *</label>
              <input
                class="staff-field__input"
                type="email"
                id="email"
                name="email"
                value="<%= formData.email || '' %>"
                required
                autocomplete="email"
              />
              <p class="staff-field__hint">The invitation is delivered to this address through the standard access flow.</p>
            </div>
          </div>

          <div class="staff-form__section">
            <fieldset class="staff-fieldset">
              <legend class="staff-form__section-title">Roles *</legend>
              <p class="staff-field__hint">Select at least one workspace this account may use.</p>

              <% if (assignableRoles.length > 0) { %>
                <ul class="staff-role-options">
                  <% assignableRoles.forEach((role) => { %>
                    <li class="staff-role-option<%= role.canDelegate ? '' : ' staff-role-option--disabled' %>">
                      <input
                        class="staff-role-option__input"
                        type="checkbox"
                        id="role-<%= role.name %>"
                        name="roles"
                        value="<%= role.name %>"
                        <%= formData.roles.includes(role.name) ? 'checked' : '' %>
                        <%= role.canDelegate ? '' : 'disabled' %>
                      />
                      <div class="staff-role-option__body">
                        <label class="staff-role-option__label" for="role-<%= role.name %>"><%= role.label %></label>
                        <p class="staff-role-option__description"><%= role.description %></p>
                        <% if (!role.canDelegate) { %>
                          <p class="staff-role-option__note">You are not authorized to delegate this role.</p>
                        <% } %>
                      </div>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <p class="staff-role-options__empty">No roles are available for delegation in this environment.</p>
              <% } %>
            </fieldset>
          </div>

          <% const superuserOption = assignableRoles.find((role) => role.name === superuserRole); %>
          <% if (superuserOption && superuserOption.canDelegate) { %>
            <section class="staff-notice staff-notice--critical">
              <strong class="staff-notice__title">Superuser delegation warning</strong>
              <p class="staff-notice__text">
                Selecting <%= superuserOption.label %> grants full system access, including role
                delegation and platform controls. Only assign it to an account you fully control.
              </p>
              <div class="staff-confirm">
                <input class="staff-confirm__input" type="checkbox" id="confirmSuperuser" name="confirmSuperuser" value="yes" />
                <label class="staff-confirm__label" for="confirmSuperuser">I confirm this account may be delegated superuser access.</label>
              </div>
            </section>
          <% } %>

          <div class="staff-form__footer">
            <button type="submit" class="staff-button staff-button--primary">Create / Invite user</button>
            <a class="staff-button staff-button--ghost" href="/staff">Cancel</a>
          </div>
        </form>
      </section>
    </main>

    <%- include("../../partials/footer") %>
  </body>
</html>
