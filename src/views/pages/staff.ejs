<%- include("../layouts/base", {
  title, appTitle, currentUserEmail: email, currentUserHref: "/account",
  pageTitle: "Staff", pageMeta: "Internal user list", activeRoleLabel: "Staff",
  showRoleSwitch: true, showExitLink: true,
  body: `
    <section class="panel">
      <h1>Staff</h1>
      <p>Internal user accounts and assigned authentication roles. User management actions are not available from this view.</p>
      <table>
        <thead><tr><th>Email</th><th>Status</th><th>Roles</th></tr></thead>
        <tbody>${staff.map((user) => `<tr><td>${user.email}</td><td>${user.status}</td><td>${(user.roles || []).join(", ") || "—"}</td></tr>`).join("")}</tbody>
      </table>
    </section>
  `
}) %>
